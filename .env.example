# Copy this file to .env and fill in your own values.
# .env is never uploaded anywhere by this app — it stays on your computer.

# A random string used to sign login sessions. Put any long random text here.
# Optional. Set this if the app's own folder isn't a safe place for the
# database to live long-term — e.g. on Railway or any host with an
# ephemeral filesystem, point this at a file on a mounted persistent
# Volume, such as /data/classcoach.sqlite. Leave blank for local dev —
# it defaults to classcoach.sqlite right next to the code, same as always.
DB_PATH=

# Optional: paste the verification code Google/Bing give you when you add
# your site to Search Console / Webmaster Tools (the "HTML tag" method,
# not the file-upload method). Leave blank until you've signed up for
# those — see the README for the full walkthrough.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

SESSION_SECRET=change-this-to-a-long-random-string

# Which AI provider to use for question generation: "anthropic" or "openai"
AI_PROVIDER=anthropic

# Fill in whichever provider you picked above. You only need one.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: lets the app email parent reports, verification links, and
# password resets directly. Without this, you still get a shareable report
# link to send yourself (WhatsApp, SMS, etc), and other email-dependent
# features just show a clear "not configured" message instead of failing.
#
# Sends via Resend's HTTPS API (not SMTP). This matters if you're deploying
# to Railway: their Free/Trial/Hobby plans block all outbound SMTP ports
# (25, 465, 587) at the network level — confirmed by Railway's own support
# team — so raw SMTP silently fails there no matter how correctly it's
# configured. An HTTPS API call isn't affected by that block.
#
# Get a free API key at https://resend.com/api-keys (needs a verified
# sending domain — see https://resend.com/domains).
RESEND_API_KEY=
# Must be in the exact format: Name <email@yourdomain.com> — including the
# space before the angle bracket, and the domain must be verified in Resend.
SMTP_FROM=

# Self-serve payments (Razorpay). Get test-mode keys free from your
# Razorpay dashboard (no business verification needed for test mode) —
# https://dashboard.razorpay.com/app/keys. Leave blank to disable online
# payment entirely; teachers can still be upgraded manually from /admin.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended: set this to the same value you configure as
# the webhook secret in your Razorpay dashboard (Settings > Webhooks),
# pointed at https://yourdomain.com/webhooks/razorpay. This is a backstop
# that confirms payment even if the customer's browser closes right after
# paying, before the on-page confirmation would have run.
RAZORPAY_WEBHOOK_SECRET=

# Admin dashboard login — a completely separate password from any
# teacher account. Both must be set for /admin/login to work at all.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Port the app runs on locally
PORT=3000
