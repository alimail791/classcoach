# Copy this file to .env and fill in your own values.
# .env is never uploaded anywhere by this app — it stays on your computer.

# A random string used to sign login sessions. Put any long random text here.
# Optional. Set this if the app's own folder isn't a safe place for the
# database to live long-term — e.g. on Railway or any host with an
# ephemeral filesystem, point this at a file on a mounted persistent
# Volume, such as /data/classcoach.sqlite. Leave blank for local dev —
# it defaults to classcoach.sqlite right next to the code, same as always.
DB_PATH=

SESSION_SECRET=change-this-to-a-long-random-string

# Which AI provider to use for question generation: "anthropic" or "openai"
AI_PROVIDER=anthropic

# Fill in whichever provider you picked above. You only need one.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: lets the app email parent reports directly. Without these, you
# still get a shareable report link to send yourself (WhatsApp, SMS, etc).
# Example values for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an
# "app password" (not your normal password) for SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Self-serve payments (Razorpay). Get test-mode keys free from your
# Razorpay dashboard (no business verification needed for test mode) —
# https://dashboard.razorpay.com/app/keys. Leave blank to disable online
# payment entirely; teachers can still be upgraded manually from /admin.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended: set this to the same value you configure as
# the webhook secret in your Razorpay dashboard (Settings > Webhooks),
# pointed at https://yourdomain.com/webhooks/razorpay. This is a backstop
# that confirms payment even if the customer's browser closes right after
# paying, before the on-page confirmation would have run.
RAZORPAY_WEBHOOK_SECRET=

# Admin dashboard login — a completely separate password from any
# teacher account. Both must be set for /admin/login to work at all.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Port the app runs on locally
PORT=3000
