<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: 'Forgot password — ClassCoach' }) %></head>
<body>
  <div class="auth-shell">
    <div class="auth-card">
      <h1>Reset your password</h1>
      <% if (sent) { %>
        <div class="flash flash-ok">If an account exists with that email, a reset link is on its way. It expires in 1 hour.</div>
      <% } else { %>
        <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
        <form method="POST" action="/forgot-password" style="display: flex; flex-direction: column; gap: 16px;">
          <div class="field"><label>Email</label><input type="email" name="email" required></div>
          <button type="submit" class="btn btn-primary">Send reset link</button>
        </form>
      <% } %>
      <a href="/login" style="font-size: 13px; color: var(--faint);">← Back to login</a>
    </div>
  </div>
</body>
</html>
