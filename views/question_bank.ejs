<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: 'Question Bank — ClassCoach' }) %></head>
<body>
<div class="layout">
  <%- include('partials/sidebar', { active: 'bank' }) %>
  <div class="main">
    <div class="topbar">
      <h1 style="font-size: 17px;">Question Bank</h1>
      <span style="font-size: 13px; color: var(--faint);"><%= questions.length %> question<%= questions.length === 1 ? '' : 's' %></span>
    </div>
    <div class="content">

      <% if (allChapters.length > 0) { %>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <a href="/question-bank" class="badge <%= !chapterFilter ? 'badge-good' : 'badge-neutral' %>" style="text-decoration: none;">All chapters</a>
          <% allChapters.forEach(function(c) { %>
            <a href="/question-bank?chapter=<%= encodeURIComponent(c) %>" class="badge <%= chapterFilter === c ? 'badge-good' : 'badge-neutral' %>" style="text-decoration: none;"><%= c %></a>
          <% }); %>
        </div>
      <% } %>

      <% if (questions.length === 0) { %>
        <div class="card" style="padding: 24px; text-align: center; color: var(--muted); font-size: 14px;">
          <% if (chapterFilter) { %>No questions tagged "<%= chapterFilter %>" yet.<% } else { %>No questions yet — add some from any test's edit page, or generate with AI.<% } %>
        </div>
      <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <% questions.forEach(function(q, idx) { %>
            <div class="card" style="padding: 20px; display: flex; flex-direction: column; gap: 10px;">
              <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 16px;">
                <span style="font-size: 14px; color: var(--ink); line-height: 1.5;"><%= q.text %></span>
                <div style="display: flex; gap: 6px; flex-shrink: 0;">
                  <% if (q.type === 'descriptive') { %><span class="badge badge-neutral" style="white-space: nowrap;">Descriptive · <%= q.max_marks %> marks</span>
                  <% } else { %><span class="badge badge-warm" style="white-space: nowrap;"><%= q.chapter || 'General' %></span><% } %>
                </div>
              </div>
              <% if (q.type === 'mcq') { %>
                <div style="display: flex; flex-direction: column; gap: 6px; padding-left: 4px;">
                  <% q.options.forEach(function(opt, oi) { %>
                    <div style="display: flex; align-items: center; gap: 10px; font-size: 13px; color: <%= oi === q.correct_index ? '#211C15' : '#4A4032' %>;">
                      <span style="width: 16px; height: 16px; border-radius: 50%; border: 1.5px solid <%= oi === q.correct_index ? '#6B8F71' : '#D8CBB0' %>; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 10px;"><%= oi === q.correct_index ? '✓' : '' %></span>
                      <%= opt %>
                    </div>
                  <% }); %>
                </div>
              <% } %>
              <div style="font-size: 12px; color: var(--faint); padding-top: 8px; border-top: 1px solid #F3ECDF;">
                From <a href="/tests/<%= q.test_id %>/edit" style="font-weight: 600;"><%= q.test_title %></a> · <%= q.batch_name %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>

    </div>
  </div>
</div>
</body>
</html>
