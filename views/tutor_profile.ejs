<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: title }) %>
<script type="application/ld+json"><%- JSON.stringify({ '@context': 'https://schema.org', '@type': t.dir_kind === 'tutor' ? 'Person' : 'EducationalOrganization', name: name, url: canonicalUrl, description: description, address: { '@type': 'PostalAddress', addressLocality: t.dir_city, addressCountry: 'IN' } }).replace(/</g, '\\u003c') %></script>
</head>
<body>
  <%- include('partials/public_nav') %>
  <div style="max-width: 760px; margin: 0 auto; padding: 48px 24px; display: flex; flex-direction: column; gap: 20px;">
    <a href="/tutors/<%= t.dir_city_slug %>" style="font-size: 13px;">← Tutors in <%= t.dir_city %></a>
    <div style="display: flex; flex-direction: column; gap: 8px;">
      <span style="font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted);"><%= D.KINDS[t.dir_kind] || 'Tutor' %> · <%= t.dir_area ? t.dir_area + ', ' : '' %><%= t.dir_city %></span>
      <h1 style="font-size: 34px; line-height: 1.15;"><%= name %></h1>
      <p style="font-size: 17px; margin: 0;"><strong><%= t.dir_subjects %></strong><%= t.dir_classes ? ' · ' + t.dir_classes : '' %><%= t.dir_mode ? ' · ' + D.MODES[t.dir_mode] : '' %><%= t.dir_neet ? ' · NEET' : '' %></p>
    </div>
    <% if (t.dir_about) { %><p style="font-size: 16px; line-height: 1.7; color: var(--ink); margin: 0; white-space: pre-line;"><%= t.dir_about %></p><% } %>

    <div class="card" style="padding: 22px; display: flex; flex-direction: column; gap: 12px;">
      <strong style="font-size: 16px;">Join a class</strong>
      <% if (!batches.length) { %>
        <p style="margin: 0; color: var(--muted); font-size: 14px;">No open classes right now<%= wa ? ' — message them on WhatsApp.' : '.' %></p>
      <% } %>
      <% batches.forEach(function (b) { %>
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; border-top: 1px solid var(--line); padding-top: 10px;">
          <span><strong><%= b.name %></strong><%= b.subject ? ' · ' + b.subject : '' %></span>
          <a href="/join/<%= b.join_code %>" class="btn btn-primary" style="padding: 9px 16px;">Join →</a>
        </div>
      <% }) %>
      <% if (wa) { %><a href="<%= wa %>" target="_blank" rel="noopener nofollow" class="btn btn-ghost" style="align-self: flex-start;">💬 Ask on WhatsApp</a><% } %>
    </div>
    <p style="font-size: 14px; color: var(--muted); margin: 0; line-height: 1.6;">Students in this class take tests on their phone, see their marks straight away, and parents get progress reports. Powered by ClassCoach.</p>
    <p style="font-size: 12px; color: var(--faint); margin: 0;">Listed by the tutor. ClassCoach doesn't verify or endorse tutors.</p>
    <%- include('partials/get_listed') %>
  </div>
  <%- include('partials/public_footer') %>
</body>
</html>
