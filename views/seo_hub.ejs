<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: title }) %></head>
<body>
  <%- include('partials/public_nav') %>
  <div style="max-width: 980px; margin: 0 auto; padding: 56px 24px 40px; display: flex; flex-direction: column; gap: 26px;">
    <div style="display: flex; flex-direction: column; gap: 12px; max-width: 720px;">
      <h1 style="font-size: 36px; line-height: 1.15; color: var(--ink);">Question paper generator for every class and subject</h1>
      <p style="font-size: 16px; line-height: 1.6; color: var(--muted); margin: 0;">Free AI question papers with answer keys for Class 6 to 12, in English and 8 Indian languages. Pick your class and subject, or <a href="/free-question-paper-generator" style="font-weight: 700; color: var(--accent);">open the generator</a> directly.</p>
    </div>
    <% classes.forEach(function (c) { %>
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <h2 style="font-size: 20px; color: var(--ink);">Class <%= c.cls %></h2>
        <div style="display: flex; flex-wrap: wrap; gap: 8px;"><% c.pages.forEach(function (p) { %><a href="/question-paper-generator/<%= p.slug %>" class="card" style="padding: 10px 16px; font-size: 14px; font-weight: 600; color: var(--ink); text-decoration: none;"><%= p.subject %></a><% }) %></div>
      </div>
    <% }) %>
    <div style="display: flex; flex-direction: column; gap: 10px;">
      <h2 style="font-size: 20px; color: var(--ink);">By teaching language</h2>
      <div style="display: flex; flex-wrap: wrap; gap: 8px;"><% languages.forEach(function (p) { %><a href="/question-paper-generator/<%= p.slug %>" class="card" style="padding: 10px 16px; font-size: 14px; font-weight: 600; color: var(--ink); text-decoration: none;"><%= p.language %> medium</a><% }) %></div>
    </div>
  </div>
  <%- include('partials/public_footer') %>
</body>
</html>
