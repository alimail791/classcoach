<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: 'ClassCoach — AI tests, auto-grading, weak-chapter tracking' }) %></head>
<body>

  <!-- NAV -->
  <div style="position: sticky; top: 0; z-index: 20; background: rgba(251,246,238,0.92); backdrop-filter: blur(6px); border-bottom: 1px solid var(--line);">
    <div style="max-width: 1180px; margin: 0 auto; padding: 18px 32px; display: flex; align-items: center; justify-content: space-between; gap: 24px;">
      <div style="display: flex; align-items: center; gap: 10px;">
        <%- include('partials/logo', { size: 32 }) %>
        <span style="font-family: 'Newsreader', serif; font-size: 20px; color: var(--ink);">ClassCoach</span>
      </div>
      <div style="display: flex; align-items: center; gap: 18px;">
        <a href="/student/login" style="font-size: 14px; color: var(--muted);">Student login</a>
        <a href="/parent/login" style="font-size: 14px; color: var(--muted);">Parent login</a>
        <a href="/join" style="font-size: 14px; color: var(--muted);">Join a class</a>
        <a href="#demo" style="font-size: 14px; color: var(--muted);">Demo</a>
        <a href="/admin/login" style="font-size: 13px; color: var(--faint);">Admin</a>
        <a href="/login" style="font-size: 14px; font-weight: 600; color: var(--muted);">Log in</a>
        <a href="/signup" class="btn btn-dark">Start free trial</a>
      </div>
    </div>
  </div>

  <!-- HERO -->
  <div style="max-width: 1180px; margin: 0 auto; padding: 80px 32px 72px; display: flex; align-items: center; gap: 56px; flex-wrap: wrap;">
    <div style="flex: 1; min-width: 300px; max-width: 560px; display: flex; flex-direction: column; gap: 24px;">
      <div style="display: inline-flex; align-self: flex-start; padding: 6px 14px; border: 1px solid #D8A87C; border-radius: 100px; font-size: 13px; color: var(--accent-deep); background: var(--accent-tint);">Built for individual teachers &amp; tutors</div>
      <h1 style="font-size: 44px; line-height: 1.1; color: var(--ink);">Grade less.<br>Teach more.</h1>
      <p style="font-size: 17px; line-height: 1.6; color: var(--muted); margin: 0;">Turn your syllabus into ready-to-use tests, grade objective answers instantly, and see exactly which chapter each student is stuck on.</p>
      <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
        <a href="/signup" class="btn btn-primary">Start your free 1-month trial</a>
        <a href="/login" style="font-size: 14px; font-weight: 600; color: var(--ink); border-bottom: 1px solid var(--ink); padding-bottom: 2px;">Log in →</a>
      </div>
      <p style="font-size: 13px; color: var(--faint); margin: 0;">No credit card needed.</p>
    </div>
    <div style="flex: 1; min-width: 280px; display: flex; justify-content: center;">
      <div class="card" style="width: 100%; max-width: 380px; padding: 24px; display: flex; flex-direction: column; gap: 14px;">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <span style="font-size: 12px; color: var(--faint); font-weight: 600;">Chapter-wise weakness</span>
          <span style="font-size: 11px; color: var(--accent); font-weight: 600;">Physics · Class 11</span>
        </div>
        <div class="bar-row"><span class="name">Kinematics</span><div class="bar-track"><div class="bar-fill" style="width: 84%; background: #6B8F71;"></div></div><span class="pct">84%</span></div>
        <div class="bar-row"><span class="name">Newton's Laws</span><div class="bar-track"><div class="bar-fill" style="width: 61%; background: #D8A24A;"></div></div><span class="pct">61%</span></div>
        <div class="bar-row"><span class="name">Gravitation</span><div class="bar-track"><div class="bar-fill" style="width: 38%; background: #B4501C;"></div></div><span class="pct">38%</span></div>
      </div>
    </div>
  </div>

  <!-- DEMO VIDEO -->
  <div id="demo" style="background: #FFFFFF; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
    <div style="max-width: 900px; margin: 0 auto; padding: 64px 32px; text-align: center;">
      <h2 style="font-size: 28px; color: var(--ink); margin-bottom: 12px;">See it in action</h2>
      <p style="font-size: 15px; color: var(--muted); margin: 0 0 32px;">A 90-second walkthrough — from syllabus to graded results.</p>
      <video
        controls
        preload="none"
        poster="/demo-poster.jpg"
        style="width: 100%; max-width: 800px; border-radius: 12px; border: 1px solid var(--line); box-shadow: 0 8px 24px rgba(0,0,0,0.08);"
      >
        <source src="/demo.mp4" type="video/mp4">
        Your browser doesn't support embedded video — <a href="/demo.mp4">download the demo</a> instead.
      </video>
    </div>
  </div>

  <!-- FEATURES -->
  <div style="background: #FFFFFF; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
    <div style="max-width: 1180px; margin: 0 auto; padding: 72px 32px;">
      <h2 style="font-size: 28px; color: var(--ink); margin-bottom: 40px;">Everything you need, nothing you don't</h2>
      <div class="grid-2">
        <div class="card" style="padding: 26px; display: flex; flex-direction: column; gap: 10px;">
          <span style="font-size: 20px;">📄</span>
          <h3 style="font-size: 17px;">AI question generation</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Paste a syllabus or upload a PDF — get chapter-tagged questions in minutes, ready to review.</p>
        </div>
        <div class="card" style="padding: 26px; display: flex; flex-direction: column; gap: 10px;">
          <span style="font-size: 20px;">✓</span>
          <h3 style="font-size: 17px;">Automatic evaluation</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Objective answers are graded the moment a student submits — no marking pile.</p>
        </div>
        <div class="card" style="padding: 26px; display: flex; flex-direction: column; gap: 10px;">
          <span style="font-size: 20px;">📊</span>
          <h3 style="font-size: 17px;">Chapter-wise tracking</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Every result rolls up into a per-student, per-chapter picture — not just a score.</p>
        </div>
        <div class="card" style="padding: 26px; display: flex; flex-direction: column; gap: 10px;">
          <span style="font-size: 20px;">💬</span>
          <h3 style="font-size: 17px;">Parent reports</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Share a result the moment it's graded — a link, an email, or their own parent login.</p>
        </div>
        <div class="card" style="padding: 26px; display: flex; flex-direction: column; gap: 10px;">
          <span style="font-size: 20px;">🖥️</span>
          <h3 style="font-size: 17px;">Slides &amp; notes</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Generate a slide deck or class notes from the same source material, and share them with your class.</p>
        </div>
        <div class="card" style="padding: 26px; display: flex; flex-direction: column; gap: 10px;">
          <span style="font-size: 20px;">🖨️</span>
          <h3 style="font-size: 17px;">Printable question papers</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Download any test as a PDF question paper for offline use, plus a separate answer key for yourself.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- HOW IT WORKS -->
  <div>
    <div style="max-width: 1180px; margin: 0 auto; padding: 72px 32px;">
      <h2 style="font-size: 28px; color: var(--ink); margin-bottom: 40px;">Three steps, start to finish</h2>
      <div class="grid-3">
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <span style="font-family: 'Newsreader', serif; font-size: 34px; color: #D8A87C;">01</span>
          <h3 style="font-size: 17px;">Upload your syllabus</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Paste a chapter outline or upload a PDF — ClassCoach drafts questions by chapter.</p>
        </div>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <span style="font-family: 'Newsreader', serif; font-size: 34px; color: #D8A87C;">02</span>
          <h3 style="font-size: 17px;">Review and publish</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Edit anything that needs a fix, then publish the test for your class to take on their own phone.</p>
        </div>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <span style="font-family: 'Newsreader', serif; font-size: 34px; color: #D8A87C;">03</span>
          <h3 style="font-size: 17px;">Get results and reports</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Objective answers grade instantly. You see the weak chapters, and parents get their update.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- PRICING -->
  <div style="background: #FFFFFF; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
    <div style="max-width: 1180px; margin: 0 auto; padding: 72px 32px;">
      <h2 style="font-size: 28px; color: var(--ink); margin-bottom: 12px;">Simple 3-month pricing, per teacher</h2>
      <p style="font-size: 15px; color: var(--muted); margin: 0 0 40px;">Start free. No card needed.</p>
      <% if (neetJeeEnabled) { %>
      <div class="pt-tabs" style="display:inline-flex;background:#EFE6D8;border-radius:100px;padding:4px;gap:2px;margin-bottom:32px;">
        <button type="button" data-pt="gen" aria-pressed="true" style="border:none;padding:9px 20px;border-radius:100px;font-size:13px;font-weight:700;cursor:pointer;">School &amp; general</button>
        <button type="button" data-pt="nj" aria-pressed="false" style="border:none;padding:9px 20px;border-radius:100px;font-size:13px;font-weight:700;cursor:pointer;">NEET &amp; JEE coaches</button>
      </div>
      <style>.pt-tabs button{background:transparent;color:var(--muted)}.pt-tabs button[aria-pressed="true"]{background:var(--ink);color:#FBF6EE}</style>
      <div id="pt-gen">
      <% } %>
      <div class="grid-4">
        <div class="card" style="padding: 26px; display: flex; flex-direction: column; gap: 10px;">
          <span style="font-size: 15px; font-weight: 700;">Free Trial</span>
          <div><span style="font-family: 'Newsreader', serif; font-size: 30px;">₹0</span><span style="font-size: 13px; color: var(--faint);"> / 1 month</span></div>
          <span style="font-size: 13px; color: var(--muted);">Up to 10 students</span>
        </div>
        <div class="card" style="padding: 26px; display: flex; flex-direction: column; gap: 10px; border-color: var(--accent);">
          <span style="font-size: 15px; font-weight: 700; color: var(--accent-deep);">Starter</span>
          <div><span style="font-family: 'Newsreader', serif; font-size: 30px;">₹499</span><span style="font-size: 13px; color: var(--faint);"> / 3 months</span></div>
          <span style="font-size: 13px; color: var(--muted);">Up to 20 students</span>
        </div>
        <div class="card" style="padding: 26px; display: flex; flex-direction: column; gap: 10px;">
          <span style="font-size: 15px; font-weight: 700;">Growth</span>
          <div><span style="font-family: 'Newsreader', serif; font-size: 30px;">₹999</span><span style="font-size: 13px; color: var(--faint);"> / 3 months</span></div>
          <span style="font-size: 13px; color: var(--muted);">Up to 50 students</span>
        </div>
        <div class="card" style="padding: 26px; display: flex; flex-direction: column; gap: 10px;">
          <span style="font-size: 15px; font-weight: 700;">Pro</span>
          <div><span style="font-family: 'Newsreader', serif; font-size: 30px;">₹1,999</span><span style="font-size: 13px; color: var(--faint);"> / 3 months</span></div>
          <span style="font-size: 13px; color: var(--muted);">Up to 100 students</span>
        </div>
      </div>
      <% if (neetJeeEnabled) { %>
      </div>
      <div id="pt-nj" style="display:none;"><%- include('partials/nj_pricing', { tiers: njTiers, mode: 'public' }) %></div>
      <script>
      document.querySelectorAll('.pt-tabs button').forEach(function(b){b.addEventListener('click',function(){
        var nj=b.getAttribute('data-pt')==='nj';
        document.getElementById('pt-gen').style.display=nj?'none':'';
        document.getElementById('pt-nj').style.display=nj?'':'none';
        document.querySelectorAll('.pt-tabs button').forEach(function(x){x.setAttribute('aria-pressed',x===b?'true':'false');});
      });});
      </script>
      <% } %>
      <p style="font-size: 12px; color: var(--faint); margin-top: 20px;">Plans are assigned by the ClassCoach team after enrollment — sign up for the free trial to get started.</p>
    </div>
  </div>

  <!-- FAQ -->
  <div style="background: #FFFFFF; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
    <div style="max-width: 780px; margin: 0 auto; padding: 72px 32px;">
      <h2 style="font-size: 28px; color: var(--ink); margin-bottom: 40px; text-align: center;">Questions teachers usually ask</h2>
      <div style="display: flex; flex-direction: column; gap: 28px;">
        <div>
          <h3 style="font-size: 16px; color: var(--ink); margin-bottom: 8px;">Does this work for descriptive/long-answer questions?</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Yes. Objective answers (MCQ, fill-in-the-blank) are graded automatically the moment a student submits. Descriptive answers are graded by you on a simple marking screen, with the final score updating once you're done.</p>
        </div>
        <div>
          <h3 style="font-size: 16px; color: var(--ink); margin-bottom: 8px;">How do parents get the report?</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Three ways, your choice: a shareable link you send however you like, a direct email if you've set that up, or their own separate parent login where every report you've shared appears automatically.</p>
        </div>
        <div>
          <h3 style="font-size: 16px; color: var(--ink); margin-bottom: 8px;">What if a student doesn't have reliable internet for a test?</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Download any test as a printable PDF question paper and run it on paper — you'll still get the same chapter-tagged question bank and answer key for your own reference.</p>
        </div>
        <div>
          <h3 style="font-size: 16px; color: var(--ink); margin-bottom: 8px;">Where does my data live?</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">In your own database on your own server — it's not sent anywhere else. You can download a full backup of everything at any time.</p>
        </div>
        <div>
          <h3 style="font-size: 16px; color: var(--ink); margin-bottom: 8px;">Can I add my whole class at once?</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Yes — import a class list from a .csv or .xlsx spreadsheet, or add students one at a time. Each student and each parent gets their own separate login.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div style="background: var(--ink); color: #FBF6EE;">
    <div style="max-width: 720px; margin: 0 auto; padding: 72px 32px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 18px;">
      <h2 style="font-size: 28px; color: #FBF6EE;">Start free. See it save you time.</h2>
      <p style="font-size: 15px; color: #C9BEA9; margin: 0;">Set up your first class and test in a few minutes — no card required.</p>
      <a href="/signup" class="btn btn-primary" style="margin-top: 8px;">Start your free 1-month trial</a>
    </div>
  </div>

  <!-- FOOTER -->
  <div style="border-top: 1px solid var(--line);">
    <div style="max-width: 1180px; margin: 0 auto; padding: 28px 32px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <%- include('partials/logo', { size: 22 }) %>
        <span style="font-family: 'Newsreader', serif; font-size: 16px;">ClassCoach</span>
      </div>
      <div style="display: flex; align-items: center; gap: 18px; flex-wrap: wrap;">
        <a href="mailto:info@classcoach.in" style="font-size: 13px; color: var(--faint);">info@classcoach.in</a>
        <a href="https://wa.me/919443424064?text=Hi%2C%20I%27d%20like%20to%20know%20more%20about%20ClassCoach" style="font-size: 13px; color: var(--faint);" target="_blank" rel="noopener">WhatsApp us</a>
        <a href="/student/login" style="font-size: 13px; color: var(--faint);">Student login →</a>
      </div>
    </div>
  </div>

  <!-- Floating WhatsApp chat button -->
  <a
    href="https://wa.me/919443424064?text=Hi%2C%20I%27d%20like%20to%20know%20more%20about%20ClassCoach"
    target="_blank"
    rel="noopener"
    aria-label="Chat with us on WhatsApp"
    style="position: fixed; bottom: 24px; right: 24px; z-index: 30; width: 56px; height: 56px; border-radius: 50%; background: #25D366; display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 18px rgba(0,0,0,0.25); text-decoration: none;"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="30" height="30" fill="#FFFFFF">
      <path d="M16.004 2.667c-7.363 0-13.333 5.97-13.333 13.333 0 2.354.617 4.56 1.696 6.474L2.667 29.333l7.03-1.843a13.27 13.27 0 0 0 6.307 1.606h.006c7.363 0 13.333-5.97 13.333-13.333S23.367 2.667 16.004 2.667zm0 24.4a11.02 11.02 0 0 1-5.62-1.542l-.403-.24-4.172 1.094 1.114-4.067-.263-.418a11.02 11.02 0 0 1-1.69-5.894c0-6.097 4.963-11.06 11.06-11.06 2.955 0 5.734 1.152 7.823 3.242a10.99 10.99 0 0 1 3.238 7.824c0 6.097-4.963 11.06-11.087 11.06zm6.07-8.287c-.333-.167-1.97-.973-2.276-1.083-.306-.11-.53-.167-.752.167-.223.333-.863 1.083-1.06 1.307-.194.223-.39.25-.723.083-.333-.167-1.404-.517-2.674-1.65-.988-.882-1.657-1.972-1.85-2.305-.194-.334-.02-.514.146-.68.15-.15.334-.39.5-.584.167-.194.223-.333.334-.556.11-.223.056-.417-.028-.584-.083-.167-.752-1.813-1.03-2.483-.272-.653-.548-.565-.752-.575l-.64-.011c-.223 0-.584.083-.89.417s-1.17 1.144-1.17 2.79 1.198 3.24 1.365 3.463c.167.223 2.355 3.595 5.706 5.042.797.344 1.42.55 1.905.704.8.254 1.53.218 2.106.132.643-.096 1.97-.805 2.248-1.583.278-.777.278-1.443.194-1.583-.083-.14-.306-.223-.64-.39z"/>
    </svg>
  </a>

<script type="application/ld+json">
