  "mainEntity": [
    {
      "@type": "Question",
      "name": "What are AI credits?",
      "acceptedAnswer": { "@type": "Answer", "text": "Every plan includes AI credits each month for AI work: an MCQ set of up to 10 questions uses 2 credits, notes or slides 3, a student practice set 2, and an AI grading suggestion 1. Monthly credits reset each month. If you run out, buy a top-up (100 credits for ₹99). Tests, auto-grading, Live Quiz and reports never use credits." }
    },
    {
      "@type": "Question",
      "name": "Does this work for descriptive/long-answer questions?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. Objective answers (MCQ, fill-in-the-blank) are graded automatically the moment a student submits. Descriptive answers are graded by you on a simple marking screen, with the final score updating once you're done." }
    },
    {
      "@type": "Question",
      "name": "How do parents get the report?",
      "acceptedAnswer": { "@type": "Answer", "text": "Three ways, your choice: a shareable link you send however you like, a direct email if you've set that up, or their own separate parent login where every report you've shared appears automatically." }
    },
    {
      "@type": "Question",
      "name": "What if a student doesn't have reliable internet for a test?",
      "acceptedAnswer": { "@type": "Answer", "text": "Download any test as a printable PDF question paper and run it on paper — you'll still get the same chapter-tagged question bank and answer key for your own reference." }
    },
    {
      "@type": "Question",
      "name": "How does Live Quiz work?",
      "acceptedAnswer": { "@type": "Answer", "text": "Pick one of your tests (or, for NEET and JEE coaches, chapters from the question bank) and start the game. Students join on their phones with the QR code or game PIN shown on your screen, answer against the clock, and see a live leaderboard. When it ends you get each student's score and rank, and can send each parent the result on WhatsApp." }
    },
    {
      "@type": "Question",
      "name": "Where does my data live?",
      "acceptedAnswer": { "@type": "Answer", "text": "On ClassCoach's own secure servers. It is used only to run ClassCoach for you, and you can download a full backup of everything at any time." }
    },
    {
      "@type": "Question",
      "name": "Can I add my whole class at once?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes — import a class list from a .csv or .xlsx spreadsheet, or add students one at a time. Each student and each parent gets their own separate login." }
    }
  ]
}
</script>
