<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: 'AI Test & Question Paper Generator for Teachers | ClassCoach' }) %></head>
<body>
<style>
  .nav-login{position:relative}
  .nav-login summary::-webkit-details-marker{display:none}
  .nav-login-menu{position:absolute;right:0;top:28px;background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.08);padding:6px;display:flex;flex-direction:column;min-width:170px;z-index:30}
  .nav-login-menu a{padding:8px 12px;border-radius:6px;font-size:14px;color:var(--ink)}
  .nav-login-menu a:hover{background:var(--accent-tint)}
  @media (max-width:640px){.nav-wide{display:none}.nav-login-menu{left:0;right:auto}}
</style>

  <!-- NAV -->
  <div style="position: sticky; top: 0; z-index: 20; background: rgba(251,246,238,0.92); backdrop-filter: blur(6px); border-bottom: 1px solid var(--line);">
    <div style="max-width: 1180px; margin: 0 auto; padding: 18px 32px; display: flex; align-items: center; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap;">
      <div style="display: flex; align-items: center; gap: 10px;">
        <%- include('partials/logo', { size: 32 }) %>
        <span style="font-family: 'Newsreader', serif; font-size: 20px; color: var(--ink);">ClassCoach</span>
      </div>
      <div style="display: flex; align-items: center; gap: 10px 18px; flex-wrap: wrap;">
        <a href="#features" class="nav-wide" style="font-size: 14px; color: var(--muted);">Features</a>
        <a href="#live-quiz" class="nav-wide" style="font-size: 14px; color: var(--muted);">Live Quiz</a>
        <a href="/pricing" class="nav-wide" style="font-size: 14px; color: var(--muted);">Pricing</a>
        <a href="/free-tools" class="nav-wide" style="font-size: 14px; color: var(--muted);">Free tools</a>
        <a href="/blog" class="nav-wide" style="font-size: 14px; color: var(--muted);">Blog</a>
        <details class="nav-login">
          <summary style="font-size: 14px; font-weight: 600; color: var(--muted); cursor: pointer; list-style: none;">Log in ▾</summary>
          <div class="nav-login-menu">
            <a href="/login">Teacher</a>
            <a href="/student/login">Student</a>
            <a href="/parent/login">Parent</a>
            <a href="/institute/login">Institute</a>
            <a href="/play">Join a live quiz</a>
            <a href="/join">Join a class</a>
            <a href="/admin/login" style="color: var(--faint);">Admin</a>
          </div>
        </details>
        <a href="/signup" class="btn btn-dark">Start free trial</a>
      </div>
    </div>
  </div>

  <!-- HERO -->
  <style>
    .hero{position:relative;overflow:hidden}
    .hero::before{content:"";position:absolute;width:620px;height:620px;right:-160px;top:-180px;background:radial-gradient(circle,rgba(242,193,78,.28),rgba(242,193,78,0) 65%);pointer-events:none}
    .hero::after{content:"";position:absolute;width:520px;height:520px;left:-220px;bottom:-260px;background:radial-gradient(circle,rgba(180,80,28,.12),rgba(180,80,28,0) 65%);pointer-events:none}
    .hero-in{position:relative;max-width:1180px;margin:0 auto;padding:72px 32px 80px;display:flex;align-items:center;gap:56px;flex-wrap:wrap}
    .hero-copy{flex:1.1;min-width:300px;max-width:600px;display:flex;flex-direction:column;gap:22px}
    .hero-pill{display:inline-flex;align-self:flex-start;align-items:center;gap:8px;padding:7px 14px 7px 8px;border-radius:100px;font-size:13px;font-weight:600;color:var(--accent-deep);background:#fff;border:1px solid #E9CFB4;box-shadow:0 2px 8px rgba(140,60,19,.08)}
    .hero-pill b{background:var(--accent);color:#FBF6EE;border-radius:100px;padding:2px 8px;font-size:11px;letter-spacing:.3px}
    .hero h1{font-size:64px;line-height:1.02;letter-spacing:-1px;color:var(--ink)}
    .hero h1 .hl{color:var(--accent);position:relative;white-space:nowrap}
    .hero h1 .hl svg{position:absolute;left:0;bottom:-10px;width:100%;height:14px}
    .hero-sub{font-size:19px;line-height:1.55;color:var(--muted);margin:0;max-width:540px}
    .hero-sub strong{color:var(--ink)}
    .hero-feats{list-style:none;margin:4px 0 0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .hero-feats li{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:10px 12px;font-size:14px;color:var(--ink);line-height:1.3}
    .hero-feats .ic{flex:none;width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:17px}
    .hero-cta{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:6px}
    .hero-cta .btn-primary{padding:15px 26px;font-size:16px;border-radius:10px;box-shadow:0 8px 20px rgba(180,80,28,.28)}
    .hero-cta .btn-ghost{padding:14px 20px;font-size:15px;border-radius:10px}
    .hero-trust{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:13px;color:var(--faint);margin:0;padding:0;list-style:none}
    .hero-trust li::before{content:"✓ ";color:#15803D;font-weight:800}
    .hero-alt{font-size:14px;color:var(--muted);margin:0}
    .hero-alt a{font-weight:700}
    .hero-art{flex:.9;min-width:290px;display:flex;justify-content:center}
    .stack{position:relative;width:100%;max-width:400px;padding:26px 0 78px}
    .stack .card{border-radius:16px;box-shadow:0 18px 40px rgba(33,28,21,.10)}
    .s-test{padding:16px 18px;display:flex;align-items:center;gap:12px;margin:0 28px -14px 0;position:relative;z-index:1;transform:rotate(-2deg)}
    .s-test .doc{width:40px;height:40px;border-radius:10px;background:var(--accent-tint);display:flex;align-items:center;justify-content:center;font-size:20px;flex:none}
    .s-main{padding:22px;display:flex;flex-direction:column;gap:13px;position:relative;z-index:2}
    .float{position:absolute;z-index:3;border-radius:14px;font-size:13px;box-shadow:0 12px 28px rgba(33,28,21,.16);animation:bob 5s ease-in-out infinite}
    .f-graded{top:6px;right:-14px;background:#15803D;color:#fff;font-weight:700;padding:9px 14px}
    .f-wa{bottom:0;left:-22px;background:#DCF8C6;color:#1F2D1A;padding:10px 14px;max-width:230px;line-height:1.4;animation-delay:1.2s}
    .f-wa small{display:block;color:#5B7052;font-size:11px;margin-bottom:2px;font-weight:700}
    @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
    .s-main .bar-fill{animation:grow 1.4s ease-out both}
    @keyframes grow{from{width:0}}
    @media (prefers-reduced-motion:reduce){.float,.s-main .bar-fill{animation:none}}
    @media (max-width:640px){
      .hero-in{padding:44px 20px 56px;gap:40px}
      .hero h1{font-size:46px}
      .hero-sub{font-size:17px}
      .hero-feats{grid-template-columns:1fr 1fr;gap:8px}
      .hero-feats li{font-size:13px;padding:8px 10px;gap:8px}
      .hero-feats .ic{width:28px;height:28px;font-size:15px}
      .hero-cta .btn{flex:1 1 100%}
      .f-graded{right:-4px}.f-wa{left:-4px}
    }
  </style>
  <div class="hero">
    <div class="hero-in">
      <div class="hero-copy">
        <span class="hero-pill"><b>NEW</b> AI teaching assistant for Indian teachers &amp; coaching centres</span>
        <h1>Grade less.<br><span class="hl">Teach more.<svg viewBox="0 0 300 14" preserveAspectRatio="none" aria-hidden="true"><path d="M3 10 C 60 2, 120 2, 160 7 S 260 13, 297 4" fill="none" stroke="#F2C14E" stroke-width="5" stroke-linecap="round"/></svg></span></h1>
        <p class="hero-sub">Make a test from any chapter in <strong>1 minute</strong>. It&rsquo;s <strong>marked the moment students submit</strong>, you see who is weak in which chapter, and parents get the result on <strong>WhatsApp</strong>. Your evenings are yours again.</p>
        <ul class="hero-feats">
          <li><span class="ic" style="background:#FDF0E3">⚡</span><span><strong>1-minute tests</strong> from PDF or a textbook photo</span></li>
          <li><span class="ic" style="background:#E8F4EA">✅</span><span><strong>Auto-graded</strong>, zero correction</span></li>
          <li><span class="ic" style="background:#FDEDEA">🎯</span><span><strong>Weak chapters</strong> for every student</span></li>
          <li><span class="ic" style="background:#E6F6E9">📲</span><span><strong>WhatsApp reports</strong> for parents</span></li>
          <li><span class="ic" style="background:#EEF0FB">📚</span><span><strong>3,600+ NEET/JEE</strong> questions ready</span></li>
          <li><span class="ic" style="background:#FFF6D9">🎮</span><span><strong>Live Quiz</strong> games for 300 students</span></li>
        </ul>
        <div class="hero-cta">
          <a href="/signup" class="btn btn-primary">Start free for 1 month →</a>
          <a href="#demo" class="btn btn-ghost">▶ Watch 90-sec demo</a>
        </div>
        <ul class="hero-trust"><li>No card needed</li><li>No app to install</li><li>Works on any phone</li><li><a href="/pricing" style="color: inherit;">From ₹250/month</a></li></ul>
        <p class="hero-alt">Run an institute? <a href="/signup?type=institute">Try free for 14 days</a> · Just need a paper? <a href="/free-question-paper-generator">Free question paper generator</a></p>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="stack">
          <div class="float f-graded">✓ 26 of 26 graded</div>
          <div class="card s-test">
            <span class="doc">📄</span>
            <span style="display:flex;flex-direction:column;gap:2px;"><strong style="font-size:14px;">Unit test · Class 11 Physics</strong><span style="font-size:12px;color:var(--faint);">20 MCQs made from a textbook photo · 52 sec</span></span>
          </div>
          <div class="card s-main">
            <div style="display:flex;align-items:center;justify-content:space-between;">
              <span style="font-size:12px;color:var(--faint);font-weight:700;letter-spacing:.3px;">CHAPTER-WISE WEAKNESS</span>
              <span style="font-size:11px;color:var(--accent);font-weight:700;">Class average</span>
            </div>
            <div class="bar-row"><span class="name">Kinematics</span><div class="bar-track"><div class="bar-fill" style="width: 84%; background: #6B8F71;"></div></div><span class="pct">84%</span></div>
            <div class="bar-row"><span class="name">Newton's Laws</span><div class="bar-track"><div class="bar-fill" style="width: 61%; background: #D8A24A;"></div></div><span class="pct">61%</span></div>
            <div class="bar-row"><span class="name">Gravitation</span><div class="bar-track"><div class="bar-fill" style="width: 38%; background: #B4501C;"></div></div><span class="pct">38%</span></div>
            <div style="background:var(--accent-tint);border-radius:10px;padding:10px 12px;font-size:13px;color:var(--accent-deep);">🎯 Plan a revision class on <strong>Gravitation</strong></div>
          </div>
          <div class="float f-wa"><small>WhatsApp · to Ananya's parent</small>Ananya scored 18/20 in today's test 🎉 Needs practice: Gravitation</div>
        </div>
      </div>
    </div>
  </div>

  <!-- SOCIAL PROOF: real usage numbers (shown only once they're meaningful) and admin-added reviews -->
  <% if ((proof && proof.stats.length) || (proof && proof.reviews.length)) { %>
  <div style="border-top: 1px solid var(--line); background: #FFFFFF;">
    <div style="max-width: 1180px; margin: 0 auto; padding: 40px 32px; display: flex; flex-direction: column; gap: 28px;">
      <% if (proof.stats.length) { %>
      <div style="display: flex; justify-content: center; gap: 24px 56px; flex-wrap: wrap; text-align: center;">
        <% proof.stats.forEach(function (st) { %>
          <div><div style="font-family: 'Newsreader', serif; font-size: 32px; color: var(--ink);"><%= st.value %></div><div style="font-size: 13px; color: var(--muted);"><%= st.label %></div></div>
        <% }) %>
      </div>
      <% } %>
      <% if (proof.reviews.length) { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px;">
        <% proof.reviews.forEach(function (r) { %>
          <figure class="card" style="margin: 0; padding: 22px; display: flex; flex-direction: column; gap: 12px;">
            <blockquote style="margin: 0; font-size: 15px; line-height: 1.6; color: var(--ink);">“<%= r.quote %>”</blockquote>
            <figcaption style="font-size: 13px; color: var(--muted);"><strong style="color: var(--ink);"><%= r.name %></strong><% if (r.role) { %> · <%= r.role %><% } %></figcaption>
          </figure>
        <% }) %>
      </div>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- WHO IT'S FOR -->
  <div style="max-width: 1180px; margin: 0 auto; padding: 64px 32px 24px;">
    <h2 style="font-size: 28px; color: var(--ink); margin-bottom: 10px;">Made for how India teaches</h2>
    <p style="font-size: 15px; color: var(--muted); margin: 0 0 28px; max-width: 720px; line-height: 1.6;">Whether you take tuition at home or run a coaching centre, ClassCoach takes the testing and correcting off your plate.</p>
    <div class="grid-4">
      <div class="card" style="padding: 22px; display: flex; flex-direction: column; gap: 8px;"><span style="font-size: 22px;">🏠</span><h3 style="font-size: 16px;">Home tuition teachers</h3><p style="font-size: 14px; color: var(--muted); line-height: 1.55; margin: 0;">Weekly tests for 10–50 students without carrying home a pile of papers to correct.</p></div>
      <div class="card" style="padding: 22px; display: flex; flex-direction: column; gap: 8px;"><span style="font-size: 22px;">🏫</span><h3 style="font-size: 16px;">Coaching centres</h3><p style="font-size: 14px; color: var(--muted); line-height: 1.55; margin: 0;">One dashboard for every teacher and batch, and results parents can see the same day.</p></div>
      <div class="card" style="padding: 22px; display: flex; flex-direction: column; gap: 8px;"><span style="font-size: 22px;">🩺</span><h3 style="font-size: 16px;">NEET &amp; JEE coaches</h3><p style="font-size: 14px; color: var(--muted); line-height: 1.55; margin: 0;">Chapter tests from a ready bank of 3,600+ questions, including previous-year questions.</p></div>
      <div class="card" style="padding: 22px; display: flex; flex-direction: column; gap: 8px;"><span style="font-size: 22px;">📚</span><h3 style="font-size: 16px;">School teachers</h3><p style="font-size: 14px; color: var(--muted); line-height: 1.55; margin: 0;">Printable question papers in up to 4 sets, OMR sheets you can grade with a phone photo.</p></div>
    </div>
  </div>

  <!-- HOW IT WORKS -->
  <div>
    <div style="max-width: 1180px; margin: 0 auto; padding: 72px 32px;">
      <h2 style="font-size: 28px; color: var(--ink); margin-bottom: 40px;">Three steps, start to finish</h2>
      <div class="grid-3">
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <span style="font-family: 'Newsreader', serif; font-size: 34px; color: #D8A87C;">01</span>
          <h3 style="font-size: 17px;">Upload your syllabus</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Paste a chapter outline or upload a PDF — ClassCoach drafts questions by chapter.</p>
        </div>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <span style="font-family: 'Newsreader', serif; font-size: 34px; color: #D8A87C;">02</span>
          <h3 style="font-size: 17px;">Review and publish</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Edit anything that needs a fix, then publish the test for your class to take on their own phone.</p>
        </div>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <span style="font-family: 'Newsreader', serif; font-size: 34px; color: #D8A87C;">03</span>
          <h3 style="font-size: 17px;">Get results and reports</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Objective answers grade instantly. You see the weak chapters, and parents get their update.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- DEMO VIDEO -->
  <div id="demo" style="background: #FFFFFF; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
    <div style="max-width: 900px; margin: 0 auto; padding: 64px 32px; text-align: center;">
      <h2 style="font-size: 28px; color: var(--ink); margin-bottom: 12px;">See it in action</h2>
      <p style="font-size: 15px; color: var(--muted); margin: 0 0 32px;">A 90-second walkthrough — from syllabus to graded results.</p>
      <video
        controls
        preload="none"
        poster="/demo-poster.jpg"
        style="width: 100%; max-width: 800px; border-radius: 12px; border: 1px solid var(--line); box-shadow: 0 8px 24px rgba(0,0,0,0.08);"
      >
        <source src="/demo.mp4" type="video/mp4">
        Your browser doesn't support embedded video — <a href="/demo.mp4">download the demo</a> instead.
      </video>
    </div>
  </div>

  <!-- FEATURES -->
  <div id="features" style="background: #FFFFFF; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
    <div style="max-width: 1180px; margin: 0 auto; padding: 72px 32px;">
      <h2 style="font-size: 28px; color: var(--ink); margin-bottom: 40px;">Everything you need, nothing you don't</h2>
      <div class="grid-2">
        <div class="card" style="padding: 26px; display: flex; flex-direction: column; gap: 10px;">
          <span style="font-size: 20px;">📄</span>
          <h3 style="font-size: 17px;">AI question generation</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Paste a syllabus or upload a PDF — get chapter-tagged questions in minutes, ready to review.</p>
        </div>
        <div class="card" style="padding: 26px; display: flex; flex-direction: column; gap: 10px;">
          <span style="font-size: 20px;">✓</span>
          <h3 style="font-size: 17px;">Automatic evaluation</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Objective answers are graded the moment a student submits — no marking pile.</p>
        </div>
        <div class="card" style="padding: 26px; display: flex; flex-direction: column; gap: 10px;">
          <span style="font-size: 20px;">📊</span>
          <h3 style="font-size: 17px;">Chapter-wise tracking</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Every result rolls up into a per-student, per-chapter picture — not just a score.</p>
        </div>
        <div class="card" style="padding: 26px; display: flex; flex-direction: column; gap: 10px;">
          <span style="font-size: 20px;">💬</span>
          <h3 style="font-size: 17px;">Parent reports</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Share a result the moment it's graded — a link, an email, or their own parent login.</p>
        </div>
        <div class="card" style="padding: 26px; display: flex; flex-direction: column; gap: 10px;">
          <span style="font-size: 20px;">🖥️</span>
          <h3 style="font-size: 17px;">Slides &amp; notes</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Generate a slide deck or class notes from the same source material, and share them with your class.</p>
        </div>
        <div class="card" style="padding: 26px; display: flex; flex-direction: column; gap: 10px;">
          <span style="font-size: 20px;">🖨️</span>
          <h3 style="font-size: 17px;">Printable question papers</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">Download any test as a PDF question paper for offline use, plus a separate answer key for yourself.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- LIVE QUIZ -->
  <div id="live-quiz" style="background: var(--ink); color: #FBF6EE;">
    <div style="max-width: 1180px; margin: 0 auto; padding: 72px 32px; display: flex; align-items: center; gap: 56px; flex-wrap: wrap;">
      <div style="flex: 1; min-width: 300px; max-width: 580px; display: flex; flex-direction: column; gap: 20px;">
        <div style="display: inline-flex; align-self: flex-start; padding: 6px 14px; border-radius: 100px; font-size: 13px; font-weight: 700; color: var(--ink); background: #F2C14E;">New · Live Quiz</div>
        <h2 style="font-size: 34px; line-height: 1.15; color: #FBF6EE; margin: 0;">Turn any test into a live quiz game for your class</h2>
        <p style="font-size: 16px; line-height: 1.6; color: #C9BEA9; margin: 0;">Put the game on your classroom screen. Students join on their own phones and race to answer. The whole class plays at once, and you get the results the moment it ends.</p>
        <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; font-size: 15px; line-height: 1.5;">
          <li>📱 <strong>Join in seconds:</strong> students scan a QR code or type a game PIN at classcoach.in/play. No app to install.</li>
          <li>⏱️ <strong>You set the pace:</strong> 10 to 60 seconds per question.</li>
          <li>🏆 <strong>Speed counts:</strong> points for every right answer, bonus points for answering fast, and a live leaderboard after each question.</li>
          <li>📊 <strong>Instant results:</strong> every student's score and rank, and which questions the class found hardest.</li>
          <li>💬 <strong>Parents in one tap:</strong> send each parent their child's result and the chapters to practise, on WhatsApp.</li>
          <li>🩺 <strong>NEET &amp; JEE coaches:</strong> start a 5-minute revision game straight from the question bank.</li>
        </ul>
        <p style="font-size: 13px; color: #A99F8C; margin: 0;">Uses the multiple-choice questions from your tests. Up to 30 players on the free trial, 300 on any paid plan.</p>
        <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
          <a href="/signup" class="btn btn-primary">Try Live Quiz free</a>
          <a href="/play" style="font-size: 14px; font-weight: 600; color: #FBF6EE; border-bottom: 1px solid #FBF6EE; padding-bottom: 2px;">Student? Join a game →</a>
        </div>
      </div>
      <div style="flex: 1; min-width: 280px; display: flex; justify-content: center;">
        <div style="width: 100%; max-width: 360px; background: #FBF6EE; color: var(--ink); border-radius: 16px; padding: 22px; box-shadow: 0 16px 40px rgba(0,0,0,0.3); display: flex; flex-direction: column; gap: 12px;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 12px; font-weight: 700; color: var(--faint);">LEADERBOARD · Question 5 of 10</span>
            <span style="font-size: 12px; font-weight: 700; color: var(--accent);">PIN 482 913</span>
