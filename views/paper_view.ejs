<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: paper.title + ' — Question Paper' }) %></head>
<body>
<div class="layout">
  <%- include('partials/sidebar', { active: 'papers' }) %>
  <div class="main">
    <div class="topbar">
      <div class="crumbs"><a href="/papers" style="font-size:14px;">← Question Papers</a><span class="divider-v"></span><h1 style="font-size:17px;"><%= paper.title %></h1></div>
      <form method="POST" action="/papers/<%= paper.id %>/delete" onsubmit="return confirm('Delete this paper?');"><button class="btn btn-ghost" style="padding:8px 14px;">Delete</button></form>
    </div>
    <div class="content">
      <% if (notice) { %><div class="flash flash-error"><%= notice %></div><% } %>
      <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

      <div class="grid-2" style="align-items:start;">
        <div class="card" style="padding:20px;display:flex;flex-direction:column;gap:12px;">
          <h2 style="font-size:18px;">Print</h2>
          <span style="font-size:13px;color:var(--muted);"><%= view.totalQuestions %> questions · <%= view.totalMarks %> marks · <%= paper.header.duration %> minutes</span>
          <table class="plain">
            <tbody>
              <% letters.forEach(function (L) { %>
                <tr><td><strong>Set <%= L %></strong></td>
                  <td><a href="/papers/<%= paper.id %>/print?set=<%= L %>" target="_blank">Question paper</a></td>
                  <td><a href="/papers/<%= paper.id %>/print?set=<%= L %>&key=1" target="_blank">Answer key</a></td>
                  <% if (typeof omrEnabled !== 'undefined' && omrEnabled && view.key.length) { %><td><a href="/papers/<%= paper.id %>/omr-sheet?set=<%= L %>" target="_blank">OMR sheet</a></td><% } %>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <form method="POST" action="/papers/<%= paper.id %>/settings" style="display:flex;gap:8px;align-items:center;font-size:13px;">
            Sets: <select name="sets" style="padding:6px;border:1px solid var(--line);border-radius:6px;"><% [1,2,3,4].forEach(function (n) { %><option <%= n === paper.sets ? 'selected' : '' %>><%= n %></option><% }) %></select>
            <button class="btn btn-ghost" style="padding:6px 12px;font-size:12px;">Save</button>
          </form>
          <% if (omrEnabled) { %><a class="btn btn-dark" href="/papers/<%= paper.id %>/omr" style="align-self:flex-start;padding:9px 14px;">Scan OMR sheets</a><% } %>
          <span style="font-size:12px;color:var(--faint);">Sets B–D shuffle the MCQ order and options. Each set has its own answer key. Open a page and use your browser's Print → Save as PDF.</span>
        </div>
        <div class="card" style="padding:20px;display:flex;flex-direction:column;gap:12px;">
          <h2 style="font-size:18px;">Use it online too</h2>
          <p style="font-size:13px;color:var(--muted);margin:0;">Turn Set A into a ClassCoach test for a batch. MCQs are auto-graded (1 mark each online); written answers come to you for grading.</p>
          <% if (batches.length) { %>
            <form method="POST" action="/papers/<%= paper.id %>/to-test" style="display:flex;gap:8px;flex-wrap:wrap;">
              <select name="batch_id" style="padding:9px;border:1px solid var(--line);border-radius:6px;"><% batches.forEach(function (b) { %><option value="<%= b.id %>"><%= b.name %></option><% }) %></select>
              <button class="btn btn-dark" style="padding:9px 14px;">Create online test</button>
            </form>
          <% } else { %><p style="font-size:13px;margin:0;"><a href="/classes">Create a batch</a> first.</p><% } %>
        </div>
      </div>

      <% view.sections.forEach(function (sec, si) { %>
        <div class="card" style="padding:20px;display:flex;flex-direction:column;gap:10px;">
          <div style="display:flex;justify-content:space-between;align-items:baseline;"><h2 style="font-size:18px;">Section <%= sec.key %> — <%= sec.title %></h2><span style="font-size:13px;color:var(--faint);"><%= sec.questions.length %> × <%= sec.marks %> = <%= sec.questions.length * sec.marks %> marks</span></div>
          <% sec.questions.forEach(function (q, qi) { %>
            <div style="display:flex;gap:12px;padding:10px 0;border-top:1px solid var(--line);">
              <div style="flex:1;font-size:14px;line-height:1.5;">
                <strong><%= q.n %>.</strong> <%= q.text %>
                <% if (sec.type === 'mcq') { %>
                  <div style="display:grid;grid-template-columns:1fr 1fr;gap:2px 16px;margin-top:4px;font-size:13px;">
                    <% q.options.forEach(function (o, oi) { %><span style="<%= oi === q.correct ? 'color:#34502E;font-weight:700;' : '' %>">(<%= String.fromCharCode(97 + oi) %>) <%= o %><%= oi === q.correct ? ' ✓' : '' %></span><% }) %>
                  </div>
                <% } else if (q.answer) { %><div style="font-size:12.5px;color:var(--faint);margin-top:4px;"><strong>Key points:</strong> <%= q.answer %></div><% } %>
                <div style="margin-top:4px;"><span class="badge <%= q.source === 'ai' ? 'badge-warm' : 'badge-neutral' %>" style="font-size:10px;"><%= q.source === 'ai' ? 'AI — please check' : q.source === 'bank' ? 'NEET bank' : 'Your bank' %></span><% if (q.chapter) { %> <span style="font-size:11px;color:var(--faint);"><%= q.chapter %></span><% } %></div>
              </div>
              <form method="POST" action="/papers/<%= paper.id %>/remove"><input type="hidden" name="s" value="<%= si %>"><input type="hidden" name="i" value="<%= qi %>"><button title="Remove" style="border:none;background:none;color:var(--faint);cursor:pointer;font-size:13px;">Remove</button></form>
            </div>
          <% }) %>
        </div>
      <% }) %>
    </div>
  </div>
</div>
</body>
</html>
