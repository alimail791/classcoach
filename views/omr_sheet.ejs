<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex, nofollow">
<title>OMR sheet — <%= paper.title %> — Set <%= letter %></title>
<style>
  @page { size: A4; margin: 0; }
  html, body { margin: 0; background: #eee; }
  .bar { text-align: center; padding: 10px; font-family: system-ui, sans-serif; font-size: 13px; }
  .bar button { padding: 8px 14px; border: 1px solid #ccc; background: #fff; border-radius: 6px; cursor: pointer; }
  svg { display: block; margin: 0 auto 16px; background: #fff; width: 210mm; height: 297mm; box-shadow: 0 1px 6px rgba(0,0,0,.15); }
  text { font-family: Arial, Helvetica, sans-serif; fill: #000; }
  @media print { html, body { background: #fff; } .bar { display: none; } svg { margin: 0; box-shadow: none; } }
</style>
</head>
<body>
<div class="bar"><button onclick="window.print()">Print</button> &nbsp; Print at 100% scale ("Actual size"), on A4, one sheet per student. Photocopies work too.</div>
<svg viewBox="0 0 210 297" xmlns="http://www.w3.org/2000/svg">
  <% T.MARKERS.forEach(function (m) { %><rect x="<%= m.x %>" y="<%= m.y %>" width="<%= T.MARKER %>" height="<%= T.MARKER %>" fill="#000"/><% }) %>

  <text x="105" y="14" font-size="5" font-weight="bold" text-anchor="middle"><%= (header.school || '').toUpperCase().slice(0, 60) %></text>
  <text x="105" y="21" font-size="4" text-anchor="middle"><%= [header.exam, header.className && ('Class ' + header.className), header.subject].filter(Boolean).join(' · ').slice(0, 80) %></text>
  <text x="105" y="27.5" font-size="3.4" text-anchor="middle">OMR ANSWER SHEET   ·   SET <%= letter %>   ·   <%= count %> questions</text>
  <line x1="20" y1="31" x2="190" y2="31" stroke="#000" stroke-width="0.3"/>

  <text x="14" y="38" font-size="3.2">Name: ...................................................................................   Section: ...............</text>

  <!-- Roll number -->
  <text x="<%= T.ROLL.x0 - 3 %>" y="44.5" font-size="3" font-weight="bold">ROLL NUMBER</text>
  <% for (var c = 0; c < T.ROLL.digits; c++) { var bx = T.rollBubble(c, 0).x; %>
    <rect x="<%= bx - 3 %>" y="<%= T.ROLL.boxY %>" width="6" height="6.5" fill="none" stroke="#000" stroke-width="0.25"/>
    <% for (var d = 0; d < 10; d++) { var b = T.rollBubble(c, d); %>
      <circle cx="<%= b.x %>" cy="<%= b.y %>" r="<%= b.r %>" fill="none" stroke="#555" stroke-width="0.25"/>
      <text x="<%= b.x %>" y="<%= b.y + 0.9 %>" font-size="2.3" fill="#888" text-anchor="middle" style="fill:#999"><%= d %></text>
    <% } %>
  <% } %>

  <!-- Instructions -->
  <rect x="70" y="42" width="84" height="62" fill="none" stroke="#000" stroke-width="0.25" rx="1.5"/>
  <text x="74" y="49" font-size="3.2" font-weight="bold">HOW TO FILL</text>
  <text x="74" y="56" font-size="2.9">1. Use a black or blue ball-point pen.</text>
  <text x="74" y="61.5" font-size="2.9">2. Fill the circle completely:</text>
  <circle cx="125" cy="60.6" r="2.2" fill="#000"/>
  <text x="74" y="67" font-size="2.9">3. Wrong ways:  tick, cross or half-fill</text>
  <text x="74" y="72.5" font-size="2.9">4. Fill only ONE circle per question.</text>
  <text x="74" y="78" font-size="2.9">5. Write your roll number in the boxes</text>
  <text x="78" y="82.5" font-size="2.9">and fill one digit in each column.</text>
  <text x="74" y="88" font-size="2.9">6. Do not fold or staple this sheet,</text>
  <text x="78" y="92.5" font-size="2.9">and do not write near the black squares.</text>
  <text x="74" y="99" font-size="2.6" fill="#555" style="fill:#555">Teacher: photograph flat, whole sheet in view.</text>

  <!-- QR (paper + set) -->
  <g transform="translate(<%= T.QR.x %>, <%= T.QR.y %>) scale(<%= T.QR.size / qrSize %>)"><%- qrSvg %></g>
  <text x="<%= T.QR.x + T.QR.size / 2 %>" y="<%= T.QR.y + T.QR.size + 5 %>" font-size="3.4" font-weight="bold" text-anchor="middle">SET <%= letter %></text>

  <line x1="14" y1="<%= T.Q.y0 - 9 %>" x2="196" y2="<%= T.Q.y0 - 9 %>" stroke="#000" stroke-width="0.3"/>

  <!-- Answers -->
  <% for (var col = 0; col < T.Q.cols; col++) { if (col * T.Q.rows >= count) break; %>
    <% for (var o = 0; o < T.Q.options; o++) { var hb = T.questionBubble(col * T.Q.rows, o); %>
      <text x="<%= hb.x %>" y="<%= T.Q.y0 - 4 %>" font-size="3" font-weight="bold" text-anchor="middle"><%= 'ABCD'[o] %></text>
    <% } %>
    <% for (var r = 0; r < T.Q.rows; r++) { var qi = col * T.Q.rows + r; if (qi >= count) break; var first = T.questionBubble(qi, 0); %>
      <% if (r % 5 === 0 && r) { %><line x1="<%= first.x - T.Q.labelW + 1 %>" y1="<%= first.y - T.Q.dy / 2 %>" x2="<%= first.x + 21 %>" y2="<%= first.y - T.Q.dy / 2 %>" stroke="#bbb" stroke-width="0.2"/><% } %>
      <text x="<%= first.x - 4 %>" y="<%= first.y + 1.1 %>" font-size="3.1" font-weight="bold" text-anchor="end"><%= qi + 1 %></text>
      <% for (var o2 = 0; o2 < T.Q.options; o2++) { var b2 = T.questionBubble(qi, o2); %>
        <circle cx="<%= b2.x %>" cy="<%= b2.y %>" r="<%= b2.r %>" fill="none" stroke="#555" stroke-width="0.25"/>
      <% } %>
    <% } %>
  <% } %>

  <text x="105" y="<%= T.MARKERS[2].y + 5 %>" font-size="2.6" text-anchor="middle" fill="#666" style="fill:#666">ClassCoach OMR · Paper <%= paper.id %> · Set <%= letter %></text>
</svg>
</body>
</html>
