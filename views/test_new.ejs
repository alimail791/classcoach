<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: 'New test — ClassCoach' }) %></head>
<body>
<div class="layout">
  <%- include('partials/sidebar', { active: 'dashboard' }) %>
  <div class="main">
    <div class="topbar">
      <div class="crumbs">
        <a href="/batches/<%= batch.id %>" style="font-size: 14px; color: var(--faint);">← <%= batch.name %></a>
        <div class="divider-v"></div>
        <h1 style="font-size: 17px;">New test</h1>
      </div>
    </div>
    <div class="content" style="align-items: center;">
      <div class="card" style="max-width: 480px; width: 100%; padding: 28px;">
        <h2 style="font-size: 20px; margin-bottom: 18px;">Set up the test</h2>
        <% if (error) { %><div class="flash flash-error" style="margin-bottom: 16px;"><%= error %></div><% } %>
        <form method="POST" action="/batches/<%= batch.id %>/tests" style="display: flex; flex-direction: column; gap: 16px;">
          <div class="field"><label>Test title</label><input name="title" placeholder="Gravitation — Chapter Test" required></div>
          <div class="field"><label>Chapter / topic</label><input name="chapter" placeholder="Gravitation"></div>
          <div class="field"><label>Duration (minutes)</label><input name="duration_minutes" type="number" value="30"></div>
          <button type="submit" class="btn btn-primary">Continue — add questions →</button>
        </form>
      </div>
    </div>
  </div>
</div>
</body>
</html>
