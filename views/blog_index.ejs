<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: title }) %></head>
<body>
  <%- include('partials/public_nav') %>

  <div style="max-width: 880px; margin: 0 auto; padding: 64px 32px 24px; display: flex; flex-direction: column; gap: 14px;">
    <h1 style="font-size: 38px; line-height: 1.15; color: var(--ink);">ClassCoach Blog</h1>
    <p style="font-size: 17px; line-height: 1.65; color: var(--muted); margin: 0;">Practical guides for tutors and coaching teachers: online tests, faster checking, progress reports and growing your classes.</p>
  </div>

  <div style="max-width: 880px; margin: 0 auto; padding: 16px 32px 72px; display: flex; flex-direction: column; gap: 18px;">
    <% if (!posts.length) { %>
      <div class="card" style="padding: 28px;">
        <p style="margin: 0; color: var(--muted);">New articles are on the way. In the meantime, <a href="/" style="color: var(--accent-deep); font-weight: 600;">see what ClassCoach does</a>.</p>
      </div>
    <% } %>
    <% posts.forEach(function (p) { %>
      <a href="/blog/<%= p.slug %>" class="card" style="display: flex; gap: 20px; padding: 22px 24px; text-decoration: none; color: inherit; align-items: flex-start;">
        <% if (p.cover_image_url) { %>
          <img src="<%= p.cover_image_url %>" alt="" style="width: 150px; height: 100px; object-fit: cover; border-radius: 8px; flex: none;" loading="lazy">
        <% } %>
        <div style="display: flex; flex-direction: column; gap: 8px; min-width: 0;">
          <h2 style="font-size: 21px; line-height: 1.3; color: var(--ink); margin: 0;"><%= p.title %></h2>
          <p style="font-size: 15px; line-height: 1.6; color: var(--muted); margin: 0;"><%= p.excerpt %></p>
          <span style="font-size: 13px; color: var(--faint);"><%= p.date %></span>
        </div>
      </a>
    <% }) %>
  </div>

  <div style="background: var(--ink); color: #FBF6EE;">
    <div style="max-width: 720px; margin: 0 auto; padding: 56px 32px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px;">
      <h2 style="font-size: 24px; color: #FBF6EE;">Save hours every week on tests and checking</h2>
      <p style="font-size: 15px; color: #C9BEA9; margin: 0;">Set up your first class and test in a few minutes — no card required.</p>
      <a href="/signup" class="btn btn-primary" style="margin-top: 6px;">Start your free 1-month trial</a>
    </div>
  </div>

  <%- include('partials/public_footer', { current: 'blog' }) %>
</body>
</html>
