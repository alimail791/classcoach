<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: title }) %></head>
<body>
  <%- include('partials/public_nav') %>
  <div style="max-width: 980px; margin: 0 auto; padding: 64px 32px 48px; display: flex; flex-direction: column; gap: 28px;">
    <div style="display: flex; flex-direction: column; gap: 14px; max-width: 720px;">
      <div style="display: inline-flex; align-self: flex-start; padding: 6px 14px; border: 1px solid #D8A87C; border-radius: 100px; font-size: 13px; color: var(--accent-deep); background: var(--accent-tint);">Free · No login needed</div>
      <h1 style="font-size: 38px; line-height: 1.15; color: var(--ink);">Free tools for teachers and tutors</h1>
      <p style="font-size: 17px; line-height: 1.6; color: var(--muted); margin: 0;">Make a question paper or an OMR sheet in a minute. No account, no card, no app.</p>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px;">
      <% tools.forEach(function (t) { %>
        <a href="<%= t.href %>" class="card" style="padding: 26px; display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: var(--ink);">
          <span style="font-size: 30px;"><%= t.icon %></span>
          <span style="font-size: 19px; font-weight: 700;"><%= t.name %></span>
          <span style="font-size: 14px; line-height: 1.55; color: var(--muted);"><%= t.blurb %></span>
          <span style="font-size: 14px; font-weight: 700; color: var(--accent);">Open the tool →</span>
        </a>
      <% }) %>
    </div>
    <div class="card" style="padding: 24px; display: flex; gap: 18px; align-items: center; flex-wrap: wrap; background: var(--accent-tint); border-color: #D8A87C;">
      <div style="flex: 1; min-width: 260px;">
        <strong style="font-size: 16px;">Want tests that mark themselves?</strong>
        <p style="font-size: 14px; color: var(--muted); margin: 6px 0 0; line-height: 1.55;">With a free ClassCoach account, students take tests on their phones, answers are graded instantly, you see each student's weak chapters, and parents get results on WhatsApp.</p>
      </div>
      <a href="/signup?src=free-tools" class="btn btn-primary">Start free for 1 month</a>
    </div>
  </div>
  <%- include('partials/public_footer') %>
</body>
</html>
