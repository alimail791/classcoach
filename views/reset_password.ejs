<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: 'Reset password — ClassCoach' }) %></head>
<body>
  <div class="auth-shell">
    <div class="auth-card">
      <h1>Choose a new password</h1>
      <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
      <% if (token) { %>
        <form method="POST" action="/reset-password/<%= token %>" style="display: flex; flex-direction: column; gap: 16px;">
          <div class="field"><label>New password</label><input type="password" name="password" required minlength="6"></div>
          <button type="submit" class="btn btn-primary">Set new password</button>
        </form>
      <% } else { %>
        <a href="/forgot-password" class="btn btn-primary">Request a new reset link</a>
      <% } %>
    </div>
  </div>
</body>
</html>
