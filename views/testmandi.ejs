<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: 'TestMandi — sell tests & find resources — ClassCoach' }) %></head>
<body>
<div class="layout">
  <%- include('partials/sidebar', { active: 'testmandi' }) %>
  <div class="main">
    <div class="topbar"><h1 style="font-size: 17px;">TestMandi — sell &amp; find</h1></div>
    <div class="content" style="display:flex;flex-direction:column;gap:20px;max-width:900px;">
      <p style="margin:0;font-size:14px;color:var(--muted);line-height:1.6;">TestMandi (testmandi.in) is our marketplace for tests and teaching resources. Sell the tests you make here to students across India — <strong>you keep 80% of every sale</strong> — and pick up ready worksheets, notes and mock tests for your own classes.</p>
      <% if (notice) { %><div class="flash flash-ok"><%= notice %></div><% } %>

      <div class="card" style="padding:22px;display:flex;flex-direction:column;gap:12px;">
        <span class="badge badge-warm" style="align-self:flex-start;">1 · Earn from your tests</span>
        <h2 style="font-size:16px;margin:0;">Your tests on TestMandi</h2>
        <% if (listings.length) { %>
          <table class="plain">
            <thead><tr><th>Test</th><th>Price</th><th>Sold</th><th>Earned (gross)</th><th></th></tr></thead>
            <tbody>
            <% listings.forEach(function (l) { var s = sales[String(l.test_id)]; %>
              <tr>
                <td><%= l.title %></td>
                <td><%= inr(l.price) %></td>
                <td><%= s ? s.unitsSold : '—' %></td>
                <td><%= s ? inr(s.gross) : '—' %></td>
                <td style="white-space:nowrap;"><a href="<%= l.url %>" target="_blank" rel="noopener" style="font-size:13px;">View</a> · <a href="/tests/<%= l.test_id %>/sell" style="font-size:13px;">Update</a></td>
              </tr>
            <% }) %>
            </tbody>
          </table>
          <p style="margin:0;font-size:12px;color:var(--muted);">See payouts and add bank details at <a href="<%= sellerUrl %>" target="_blank" rel="noopener">testmandi.in</a> (log in with your ClassCoach email — the set-password link was emailed to you).</p>
        <% } else { %>
          <p style="margin:0;font-size:14px;color:var(--muted);">No tests listed yet. Any test with 5+ multiple-choice questions can be sold — the AI generator makes one in a minute.</p>
        <% } %>
        <% if (mcqTests.length) { %>
          <div style="display:flex;flex-direction:column;gap:8px;">
            <strong style="font-size:13px;">Ready to sell:</strong>
            <% mcqTests.slice(0, 8).forEach(function (x) { %>
              <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:14px;">
                <span><%= x.title %> <span style="color:var(--faint);">· <%= x.mcq %> MCQs</span></span>
                <a class="btn btn-ghost" style="font-size:12px;padding:6px 12px;" href="/tests/<%= x.id %>/sell">Sell on TestMandi</a>
              </div>
            <% }) %>
          </div>
        <% } else if (!listings.length) { %>
          <div><a class="btn btn-primary" href="/tests">Make a test →</a></div>
        <% } %>
      </div>

      <div class="card" style="padding:22px;display:flex;flex-direction:column;gap:12px;">
        <span class="badge badge-warm" style="align-self:flex-start;">2 · Save prep time</span>
        <h2 style="font-size:16px;margin:0;">Worksheets, notes &amp; tests for your class</h2>
        <form method="GET" action="/testmandi" style="display:flex;gap:8px;flex-wrap:wrap;">
          <input name="q" value="<%= q %>" placeholder="Search: Class 10 Physics, NEET Biology, worksheet…" style="flex:1;min-width:220px;">
          <button type="submit" class="btn btn-dark">Search</button>
        </form>
        <% if (!resources.length && !tests.length) { %>
          <p style="margin:0;font-size:14px;color:var(--muted);">Nothing matched<%= q ? ' "' + q + '"' : '' %>. Try a shorter search, or <a href="<%= browseUrl %>" target="_blank" rel="noopener">browse everything on TestMandi</a>.</p>
        <% } %>
        <% if (resources.length) { %>
          <strong style="font-size:13px;">Teaching resources</strong>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;">
            <% resources.forEach(function (r) { %>
              <a class="card" href="<%= resourceUrl(r) %>" target="_blank" rel="noopener" style="padding:14px;display:flex;flex-direction:column;gap:4px;text-decoration:none;color:inherit;">
                <span style="font-size:11px;color:var(--faint);"><%= r.resourceType %><%= r.grade ? ' · ' + r.grade : '' %></span>
                <strong style="font-size:14px;line-height:1.35;"><%= r.title %></strong>
                <span style="font-size:13px;color:var(--muted);"><%= r.price > 0 ? inr(r.price) : 'Free' %> · <%= r.sellerName %></span>
              </a>
            <% }) %>
          </div>
        <% } %>
        <% if (tests.length) { %>
          <strong style="font-size:13px;">Mock &amp; practice tests</strong>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;">
            <% tests.forEach(function (x) { %>
              <a class="card" href="<%= testUrl(x) %>" target="_blank" rel="noopener" style="padding:14px;display:flex;flex-direction:column;gap:4px;text-decoration:none;color:inherit;">
                <span style="font-size:11px;color:var(--faint);"><%= x.category %> · <%= x.questionCount %> Qs</span>
                <strong style="font-size:14px;line-height:1.35;"><%= x.title %></strong>
                <span style="font-size:13px;color:var(--muted);"><%= x.price > 0 ? inr(x.price) : 'Free' %> · <%= x.sellerName %></span>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="card" style="padding:22px;display:flex;flex-direction:column;gap:10px;">
        <span class="badge badge-warm" style="align-self:flex-start;">3 · Sell files too</span>
        <h2 style="font-size:16px;margin:0;">Have notes, worksheets or slides?</h2>
        <p style="margin:0;font-size:14px;color:var(--muted);line-height:1.6;">Upload PDFs, Word or PowerPoint files as resources on TestMandi and earn from them too. Only sell your own work — no scanned textbook pages or copied guides.</p>
        <div><a class="btn btn-ghost" target="_blank" rel="noopener" href="<%= sellerUrl %>">Upload on testmandi.in →</a></div>
      </div>
    </div>
  </div>
</div>
</body>
</html>
