<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: 'Website widgets — ClassCoach' }) %></head>
<body>
<%
  var copyBtn = function (id) { return '<button type="button" class="btn btn-ghost" style="padding:8px 14px;" onclick="var i=document.getElementById(\'' + id + '\');i.select();navigator.clipboard&&navigator.clipboard.writeText(i.value);this.textContent=\'Copied\';">Copy code</button>'; };
  var codeBox = function (id, code) { return '<div style="display:flex;gap:8px;flex-wrap:wrap;"><input id="' + id + '" readonly value="' + code.replace(/&/g, '&amp;').replace(/"/g, '&quot;') + '" style="flex:1;min-width:220px;font-size:12px;font-family:monospace;">' + copyBtn(id) + '</div>'; };
%>
<div class="layout">
  <%- include('partials/sidebar', { active: 'widgets' }) %>
  <div class="main">
    <div class="topbar"><h1 style="font-size: 17px;">Website widgets</h1></div>
    <div class="content" style="display:flex;flex-direction:column;gap:20px;max-width:860px;">
      <p style="margin:0;font-size:14px;color:var(--muted);line-height:1.6;">Put these on your website, blog, Google Sites page or Linktree. Copy the code and paste it where you want the box to appear (in WordPress use a "Custom HTML" block). Each one updates by itself — nothing to maintain.</p>
      <% if (notice === 'on') { %><div class="flash flash-ok">Practice quiz is on. Copy its code below.</div><% } %>
      <% if (notice === 'off') { %><div class="flash flash-ok">Practice quiz is off. Anywhere it was embedded now shows "no longer available".</div><% } %>

      <div class="card" id="listing" style="padding:22px;display:flex;flex-direction:column;gap:14px;">
        <h2 style="font-size:16px;margin:0;">📍 Get listed in the tutor directory — free</h2>
        <p style="margin:0;font-size:14px;color:var(--muted);">Parents and students searching for tutors in your city find your profile on <a href="/tutors" target="_blank">classcoach.in/tutors</a> and join your class in one tap. Tick "I teach NEET" to also appear on YNeet's NEET coaching directory.</p>
        <% if (listingError) { %><div class="flash flash-error"><%= listingError %></div><% } %>
        <% if (listingSaved) { %><div class="flash flash-ok">Saved.<% if (teacher.dir_listed && teacher.dir_slug) { %> Your profile: <a href="<%= D.profileUrl(teacher) %>" target="_blank"><%= D.profileUrl(teacher).replace('https://', '') %></a><% } %><%= yneetSync === 'listed' ? ' Also listed on YNeet\'s NEET directory.' : yneetSync === 'unlisted' ? ' Removed from YNeet\'s NEET directory.' : yneetSync === 'failed' ? ' (YNeet listing will be retried next time you save.)' : '' %></div><% } %>
        <form method="POST" action="/widgets/listing" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;">
          <label style="grid-column:1/-1;display:flex;gap:8px;align-items:center;font-weight:600;"><input type="checkbox" name="dir_listed" value="1" <%= teacher.dir_listed ? 'checked' : '' %>> Show my profile in the directory</label>
          <div class="field"><label>Name to show</label><input name="dir_display_name" maxlength="60" value="<%= teacher.dir_display_name || teacher.name %>"></div>
          <div class="field"><label>I am a</label><select name="dir_kind"><% Object.keys(D.KINDS).forEach(function (k) { %><option value="<%= k %>" <%= teacher.dir_kind === k ? 'selected' : '' %>><%= D.KINDS[k] %></option><% }) %></select></div>
          <div class="field"><label>City</label><input name="dir_city" maxlength="40" value="<%= teacher.dir_city %>" placeholder="e.g. Salem"></div>
          <div class="field"><label>Area / locality (optional)</label><input name="dir_area" maxlength="60" value="<%= teacher.dir_area %>" placeholder="e.g. Fairlands"></div>
          <div class="field"><label>Subjects</label><input name="dir_subjects" maxlength="120" value="<%= teacher.dir_subjects %>" placeholder="e.g. Maths, Physics"></div>
          <div class="field"><label>Classes (optional)</label><input name="dir_classes" maxlength="80" value="<%= teacher.dir_classes %>" placeholder="e.g. Class 9–12, CBSE & State Board"></div>
          <div class="field"><label>Classes are</label><select name="dir_mode"><option value="">—</option><% Object.keys(D.MODES).forEach(function (k) { %><option value="<%= k %>" <%= teacher.dir_mode === k ? 'selected' : '' %>><%= D.MODES[k] %></option><% }) %></select></div>
          <div class="field" style="grid-column:1/-1;"><label>About you (optional, shows on your profile)</label><textarea name="dir_about" maxlength="600" rows="3" placeholder="Experience, results, batch timings, fees range…"><%= teacher.dir_about %></textarea></div>
          <label style="display:flex;gap:8px;align-items:center;font-size:14px;"><input type="checkbox" name="dir_neet" value="1" <%= teacher.dir_neet ? 'checked' : '' %>> I teach NEET (also list me on yneet.in)</label>
          <label style="display:flex;gap:8px;align-items:center;font-size:14px;"><input type="checkbox" name="dir_whatsapp" value="1" <%= teacher.dir_whatsapp ? 'checked' : '' %>> Show a WhatsApp button (<%= teacher.phone || 'add number in Settings' %>)</label>
          <div style="grid-column:1/-1;display:flex;gap:12px;align-items:center;flex-wrap:wrap;"><button type="submit" class="btn btn-primary">Save listing</button><% if (teacher.dir_listed && teacher.dir_slug) { %><a href="<%= D.profileUrl(teacher) %>" target="_blank" style="font-size:13px;">View my profile · <%= teacher.dir_views %> views</a><% } %></div>
        </form>
      </div>

      <div class="card" style="padding:22px;display:flex;flex-direction:column;gap:14px;">
        <h2 style="font-size:16px;margin:0;">1 · "Join my class" button</h2>
        <p style="margin:0;font-size:14px;color:var(--muted);">Visitors tap it and join your batch straight away — new students without phone calls.</p>
        <% if (!batches.length) { %>
          <div class="flash flash-error">Create a class first in <a href="/classes">Classes &amp; Batches</a>.</div>
        <% } %>
        <% batches.forEach(function (b) { var src = SITE + '/embed/join/' + b.join_code; %>
          <div style="display:flex;flex-direction:column;gap:6px;border-top:1px solid var(--line);padding-top:12px;">
            <div style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;font-size:14px;"><strong><%= b.name %></strong><span style="color:var(--muted);font-size:13px;"><%= views['join:' + b.id] || 0 %> views in 30 days · <a href="<%= src %>" target="_blank" rel="noopener">Preview</a></span></div>
            <%- codeBox('j' + b.id, iframe(src, 230)) %>
          </div>
        <% }) %>
      </div>

      <div class="card" style="padding:22px;display:flex;flex-direction:column;gap:14px;">
        <h2 style="font-size:16px;margin:0;">2 · Free practice quiz</h2>
        <p style="margin:0;font-size:14px;color:var(--muted);">Turn one of your published tests into a public practice quiz (first <%= maxQuiz %> MCQs). Visitors get their score, then a "Join your class" button. <strong>Anyone can see these questions</strong>, so pick a practice test, not an exam you still plan to give.</p>
        <% var usable = tests.filter(function (x) { return x.mcq_count > 0; }); %>
        <% if (!usable.length) { %>
          <p style="margin:0;font-size:13px;color:var(--faint);">Publish a test with MCQ questions first — it will show up here.</p>
        <% } %>
        <% usable.forEach(function (x) { var src = SITE + '/embed/quiz/' + x.embed_token; %>
          <div id="quiz-<%= x.id %>" style="display:flex;flex-direction:column;gap:6px;border-top:1px solid var(--line);padding-top:12px;">
            <div style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;align-items:center;font-size:14px;">
              <span><strong><%= x.title %></strong> <span style="color:var(--muted);font-size:13px;">· <%= x.batch_name %> · <%= Math.min(x.mcq_count, maxQuiz) %> MCQs<% if (x.embed_token) { %> · <%= views['quiz:' + x.id] || 0 %> views in 30 days · <a href="<%= src %>" target="_blank" rel="noopener">Preview</a><% } %></span></span>
              <form method="POST" action="/widgets/quiz/<%= x.id %>/<%= x.embed_token ? 'off' : 'on' %>" style="margin:0;">
                <button type="submit" class="btn <%= x.embed_token ? 'btn-ghost' : 'btn-primary' %>" style="padding:8px 14px;"><%= x.embed_token ? 'Turn off' : 'Make it a widget' %></button>
              </form>
            </div>
            <% if (x.embed_token) { %><%- codeBox('q' + x.id, iframe(src, 640)) %><% } %>
          </div>
        <% }) %>
      </div>

      <div class="card" style="padding:22px;display:flex;flex-direction:column;gap:14px;">
        <h2 style="font-size:16px;margin:0;">3 · Question of the day (Physics, Chemistry, Biology)</h2>
        <p style="margin:0;font-size:14px;color:var(--muted);">A new NEET-level question every day, with the answer shown when a visitor taps an option. Keeps students coming back to your site.</p>
        <% ['', 'Physics', 'Chemistry', 'Biology'].forEach(function (s) { var src = SITE + '/embed/qotd' + (s ? '?subject=' + s : ''); %>
          <div style="display:flex;flex-direction:column;gap:6px;">
            <span style="font-size:13px;"><strong><%= s || 'Mixed (subject changes daily)' %></strong> · <a href="<%= src %>" target="_blank" rel="noopener">Preview</a></span>
            <%- codeBox('d' + (s || 'mix'), iframe(src, 470)) %>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>
</body>
</html>
