<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: page.title }) %></head>
<body>
  <%- include('partials/public_nav') %>
  <div style="max-width: 900px; margin: 0 auto; padding: 48px 24px 40px; display: flex; flex-direction: column; gap: 26px;">
    <div style="display: flex; flex-direction: column; gap: 14px;">
      <div style="display: inline-flex; align-self: flex-start; padding: 6px 14px; border: 1px solid #D8A87C; border-radius: 100px; font-size: 13px; color: var(--accent-deep); background: var(--accent-tint);">Honest comparison · facts checked <%= checked %></div>
      <h1 style="font-size: 34px; line-height: 1.15; color: var(--ink);"><%= page.h1 %></h1>
      <div class="card" style="padding: 18px 20px; display: flex; flex-direction: column; gap: 8px; font-size: 16px; line-height: 1.6;">
        <p style="margin: 0;"><%= page.verdict[0] %></p>
        <p style="margin: 0;"><strong><%= page.verdict[1] %></strong></p>
      </div>
    </div>

    <div style="display: flex; flex-direction: column; gap: 12px;">
      <h2 style="font-size: 24px; color: var(--ink);">Side by side</h2>
      <div style="overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; background: #fff;">
        <table style="border-collapse: collapse; width: 100%; min-width: 640px; font-size: 14px;">
          <thead><tr><th style="text-align: left; padding: 12px 14px; width: 20%;"></th><th style="text-align: left; padding: 12px 14px;"><%= page.competitor %></th><th style="text-align: left; padding: 12px 14px; background: #B4501C; color: #FBF6EE;">ClassCoach</th></tr></thead>
          <tbody>
            <% page.rows.forEach(function (r) { %>
              <tr>
                <th scope="row" style="text-align: left; padding: 12px 14px; border-top: 1px solid var(--line); vertical-align: top;"><%= r.topic %></th>
                <td style="padding: 12px 14px; border-top: 1px solid var(--line); vertical-align: top; color: var(--muted); line-height: 1.5;"><%= r.them %><% if (r.src) { %> <a href="<%= r.src %>" target="_blank" rel="nofollow noopener" style="font-size: 12px;">[source]</a><% } %></td>
                <td style="padding: 12px 14px; border-top: 1px solid var(--line); vertical-align: top; background: #FFF4EA; line-height: 1.5;"><%= r.us %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p style="font-size: 12px; color: var(--faint); margin: 0;"><%= page.competitor %> facts are from <%= page.competitor %>'s own pages, checked <%= checked %>. Plans and features change, so check their site for current details. Product names belong to their owners.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
      <div class="card" style="padding: 20px; display: flex; flex-direction: column; gap: 10px;">
        <h2 style="font-size: 19px; color: var(--ink);">Where <%= page.competitor %> is the better choice</h2>
        <ul style="margin: 0; padding-left: 20px; font-size: 14px; line-height: 1.65; color: var(--muted);"><% page.themWins.forEach(function (w) { %><li><%= w.text %><% if (w.src) { %> <a href="<%= w.src %>" target="_blank" rel="nofollow noopener" style="font-size: 12px;">[source]</a><% } %></li><% }) %></ul>
      </div>
      <div class="card" style="padding: 20px; display: flex; flex-direction: column; gap: 10px;">
        <h2 style="font-size: 19px; color: var(--ink);">Also in ClassCoach</h2>
        <ul style="margin: 0; padding-left: 20px; font-size: 14px; line-height: 1.65; color: var(--muted);"><% page.alsoUs.forEach(function (a) { %><li><%= a %></li><% }) %></ul>
      </div>
    </div>

    <div style="display: flex; flex-direction: column; gap: 12px;">
      <h2 style="font-size: 24px; color: var(--ink);">Switching from <%= page.competitor %></h2>
      <ol style="margin: 0; padding-left: 22px; font-size: 15px; line-height: 1.7; color: var(--muted);"><% page.switchSteps.forEach(function (s) { %><li><%= s %></li><% }) %></ol>
      <div><a href="<%= page.cta.href %>" class="btn btn-primary"><%= page.cta.label %> →</a></div>
    </div>

    <div style="display: flex; flex-direction: column; gap: 12px;">
      <h2 style="font-size: 24px; color: var(--ink);">Questions teachers ask</h2>
      <% page.faq.forEach(function (f) { %><details><summary style="font-weight: 700; cursor: pointer;"><%= f.q %></summary><p style="color: var(--muted); line-height: 1.6;"><%= f.a %></p></details><% }) %>
    </div>

    <% if (others.length) { %>
    <p style="font-size: 14px; color: var(--muted); margin: 0;">More comparisons: <% others.forEach(function (o, i) { %><a href="/vs/<%= o.slug %>" style="font-weight: 700;">ClassCoach vs <%= o.competitor %></a><%= i < others.length - 1 ? ' · ' : '' %><% }) %> · <a href="/#compare" style="font-weight: 700;">ClassCoach vs the usual way</a></p>
    <% } %>
  </div>
  <script type="application/ld+json"><%- JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: page.faq.map(function (f) { return { '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }; }) }).replace(/</g, '\\u003c') %></script>
  <%- include('partials/public_footer') %>
</body>
</html>
