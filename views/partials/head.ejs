<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<% if (typeof gaId !== 'undefined' && gaId) { %>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= gaId %>"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', '<%= gaId %>');
</script>
<% } %>
<title><%= typeof title !== 'undefined' ? title : 'ClassCoach' %></title>
<% if (process.env.GOOGLE_SITE_VERIFICATION) { %>
<meta name="google-site-verification" content="<%= process.env.GOOGLE_SITE_VERIFICATION %>">
<% } %>
<% if (process.env.BING_SITE_VERIFICATION) { %>
<meta name="msvalidate.01" content="<%= process.env.BING_SITE_VERIFICATION %>">
<% } %>
<% if (typeof description !== 'undefined' && description) { %>
<meta name="description" content="<%= description %>">
<% } %>
<% if (typeof indexable === 'undefined' || !indexable) { %>
<meta name="robots" content="noindex, nofollow">
<% } %>
<% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
<link rel="canonical" href="<%= canonicalUrl %>">
<meta property="og:url" content="<%= canonicalUrl %>">
<% } %>
<% if (typeof indexable !== 'undefined' && indexable) { %>
<meta property="og:type" content="website">
<meta property="og:site_name" content="ClassCoach">
<meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'ClassCoach' %>">
<meta property="og:description" content="<%= typeof description !== 'undefined' ? description : '' %>">
<% const _origin = process.env.SITE_ORIGIN || 'https://www.classcoach.in'; const _ogImage = (typeof ogImage !== 'undefined' && ogImage) ? ogImage : _origin + '/og-image.png'; %>
<meta property="og:image" content="<%= _ogImage %>">
<meta property="og:image:secure_url" content="<%= _ogImage %>">
<% if (typeof ogImage === 'undefined' || !ogImage) { %>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="ClassCoach logo: Grade less. Teach more. AI tests, instant grading and parent reports for teachers and tutors.">
<% } %>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="<%= _ogImage %>">
<meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'ClassCoach' %>">
<meta name="twitter:description" content="<%= typeof description !== 'undefined' ? description : '' %>">
<% } %>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#B4501C">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="stylesheet" href="/style.css">
<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', function () {
    navigator.serviceWorker.register('/sw.js').catch(function () {});
  });
}
</script>
