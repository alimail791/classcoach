<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title : 'ClassCoach' %></title>
<% if (typeof description !== 'undefined' && description) { %>
<meta name="description" content="<%= description %>">
<% } %>
<% if (typeof indexable === 'undefined' || !indexable) { %>
<meta name="robots" content="noindex, nofollow">
<% } %>
<% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
<link rel="canonical" href="<%= canonicalUrl %>">
<meta property="og:url" content="<%= canonicalUrl %>">
<% } %>
<% if (typeof indexable !== 'undefined' && indexable) { %>
<meta property="og:type" content="website">
<meta property="og:site_name" content="ClassCoach">
<meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'ClassCoach' %>">
<meta property="og:description" content="<%= typeof description !== 'undefined' ? description : '' %>">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'ClassCoach' %>">
<meta name="twitter:description" content="<%= typeof description !== 'undefined' ? description : '' %>">
<% } %>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/favicon.svg">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#B4501C">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="stylesheet" href="/style.css">
<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', function () {
    navigator.serviceWorker.register('/sw.js').catch(function () {});
  });
}
</script>
