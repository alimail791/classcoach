<div class="sidebar">
  <div class="brand">
    <%- include('logo', { size: 30 }) %>
    <span class="word">ClassCoach</span>
  </div>
  <div class="navlist">
    <a href="/dashboard" class="navitem <%= active === 'dashboard' ? 'active' : '' %>">⌂ Dashboard</a>
    <a href="/classes" class="navitem <%= active === 'classes' ? 'active' : '' %>">🏫 Classes &amp; Batches</a>
    <a href="/tests" class="navitem <%= active === 'tests' ? 'active' : '' %>">📝 Tests &amp; Worksheets</a>
    <a href="/question-bank" class="navitem <%= active === 'bank' ? 'active' : '' %>">🗂️ Question Bank</a>
    <a href="/reports" class="navitem <%= active === 'reports' ? 'active' : '' %>">📊 Reports</a>
    <a href="/students" class="navitem <%= active === 'students' ? 'active' : '' %>">👥 Students</a>
    <a href="/compare" class="navitem <%= active === 'compare' ? 'active' : '' %>">📈 Compare Classes</a>
    <a href="/upgrade" class="navitem <%= active === 'upgrade' ? 'active' : '' %>">💳 Upgrade</a>
    <a href="/settings" class="navitem <%= active === 'settings' ? 'active' : '' %>">⚙️ Settings</a>
    <a href="/help" class="navitem <%= active === 'help' ? 'active' : '' %>">❓ Help</a>
  </div>
  <div style="margin-top: auto; padding: 20px 24px 0; border-top: 1px solid #38312A; margin-top: 20px; padding-top: 20px; display: flex; align-items: center; justify-content: space-between; gap: 10px;">
    <div style="display: flex; flex-direction: column; line-height: 1.3;">
      <span style="font-size: 13px; color: #FBF6EE; font-weight: 600;"><%= teacher.name %></span>
      <span style="font-size: 12px; color: #A69D89;"><%= teacher.email %></span>
    </div>
  </div>
  <form method="POST" action="/logout" style="padding: 12px 24px 0;">
    <button type="submit" style="width: 100%; padding: 9px; background: transparent; border: 1px solid #3D342A; color: #C9BEA9; border-radius: 6px; font-size: 12px;">Log out</button>
  </form>
</div>
