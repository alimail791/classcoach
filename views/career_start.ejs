<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: 'Career Aptitude Test' }) %></head>
<body>
<div class="auth-shell">
  <div class="auth-card" style="max-width: 480px;">
    <div style="display: flex; align-items: center; gap: 10px;"><%- include('partials/logo', { size: 30 }) %><span style="font-family: 'Newsreader', serif; font-size: 19px;">ClassCoach</span></div>
    <% if (!batch) { %>
      <h1>Career Aptitude Test</h1>
      <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
      <form method="GET" action="/c" style="display: flex; flex-direction: column; gap: 14px;">
        <div class="field"><label>Test code from your teacher</label><input name="code" required maxlength="8" style="text-transform: uppercase; letter-spacing: 3px; font-size: 18px;" autofocus></div>
        <button class="btn btn-primary" type="submit">Continue</button>
      </form>
    <% } else { %>
      <div>
        <h1>Career Aptitude Test</h1>
        <p style="margin: 6px 0 0; font-size: 14px; color: var(--muted); line-height: 1.5;">
          <%= batch.level === '10' ? 'Find the Class 11 stream that suits you best.' : 'Find the courses and careers that suit you best after Class 12.' %>
          About 40 minutes. There are no wrong answers in the interest and work-style parts — answer honestly.
        </p>
        <p style="margin: 8px 0 0; font-size: 13px; color: var(--faint);">Conducted by <%= batch.school || conductor %></p>
      </div>
      <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
      <% if (batch.open) { %>
      <form method="POST" action="/c/<%= batch.code %>" style="display: flex; flex-direction: column; gap: 14px;">
        <div class="field"><label>Your full name *</label><input name="student_name" required maxlength="80" value="<%= form.student_name || '' %>"></div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="field"><label>Class &amp; section</label><input name="section" maxlength="40" placeholder="<%= batch.level === '10' ? '10 A' : '12 B' %>" value="<%= form.section || '' %>"></div>
          <div class="field"><label>Roll number</label><input name="roll_no" maxlength="20" value="<%= form.roll_no || '' %>"></div>
        </div>
        <% if (batch.level === '12') { %>
          <div class="field"><label>Your Class 12 stream *</label>
            <select name="current_stream" required><option value="">Choose…</option><% Object.keys(streams).forEach(function (k) { %><option value="<%= k %>" <%= form.current_stream === k ? 'selected' : '' %>><%= streams[k] %></option><% }) %></select></div>
        <% } %>
        <div class="field"><label>What would you like to become? (optional)</label><input name="aspiration" maxlength="120" placeholder="e.g. doctor, engineer, not sure yet" value="<%= form.aspiration || '' %>"></div>
        <div class="field"><label>Parent's WhatsApp number (optional)</label><input name="parent_phone" inputmode="tel" maxlength="15" value="<%= form.parent_phone || '' %>"><span style="font-size: 12px; color: var(--faint);">Your teacher can send the report to your parents.</span></div>
        <% if (batch.tier !== 'basic') { %>
          <div class="field"><label>Report language</label>
            <select name="language"><% languages.forEach(function (l) { %><option <%= (form.language || batch.language) === l ? 'selected' : '' %>><%= l %></option><% }) %></select></div>
        <% } %>
        <button class="btn btn-primary" type="submit">Start the test</button>
      </form>
      <% } %>
    <% } %>
  </div>
</div>
</body>
</html>
