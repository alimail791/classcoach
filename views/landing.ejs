<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: page.title }) %></head>
<body>

  <!-- NAV -->
  <div style="position: sticky; top: 0; z-index: 20; background: rgba(251,246,238,0.92); backdrop-filter: blur(6px); border-bottom: 1px solid var(--line);">
    <div style="max-width: 1180px; margin: 0 auto; padding: 18px 32px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
      <a href="/" style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
        <%- include('partials/logo', { size: 32 }) %>
        <span style="font-family: 'Newsreader', serif; font-size: 20px; color: var(--ink);">ClassCoach</span>
      </a>
      <div style="display: flex; align-items: center; gap: 18px; flex-wrap: wrap;">
        <a href="/login" style="font-size: 14px; font-weight: 600; color: var(--muted);">Log in</a>
        <a href="<%= page.signup %>" class="btn btn-dark">Start free trial</a>
      </div>
    </div>
  </div>

  <!-- HERO -->
  <div style="max-width: 880px; margin: 0 auto; padding: 72px 32px 56px; display: flex; flex-direction: column; gap: 22px;">
    <div style="display: inline-flex; align-self: flex-start; padding: 6px 14px; border: 1px solid #D8A87C; border-radius: 100px; font-size: 13px; color: var(--accent-deep); background: var(--accent-tint);"><%= page.eyebrow %></div>
    <h1 style="font-size: 40px; line-height: 1.15; color: var(--ink);"><%= page.h1 %></h1>
    <p style="font-size: 17px; line-height: 1.65; color: var(--muted); margin: 0;"><%= page.intro %></p>
    <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
      <a href="<%= page.signup %>" class="btn btn-primary">Start your free 1-month trial</a>
      <a href="/#demo" style="font-size: 14px; font-weight: 600; color: var(--ink); border-bottom: 1px solid var(--ink); padding-bottom: 2px;">Watch the 90-second demo →</a>
    </div>
    <p style="font-size: 13px; color: var(--faint); margin: 0;">No credit card needed.</p>
  </div>

  <!-- STATS -->
  <div style="max-width: 1180px; margin: 0 auto; padding: 0 32px 56px;">
    <div class="grid-3">
      <% page.stats.forEach(function (s) { %>
      <div class="card" style="padding: 24px; display: flex; flex-direction: column; gap: 6px;">
        <span style="font-family: 'Newsreader', serif; font-size: 30px; color: var(--accent-deep);"><%= s.value %></span>
        <span style="font-size: 14px; color: var(--muted);"><%= s.label %></span>
      </div>
      <% }) %>
    </div>
  </div>

  <!-- SECTIONS -->
  <div style="background: #FFFFFF; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
    <div style="max-width: 880px; margin: 0 auto; padding: 64px 32px; display: flex; flex-direction: column; gap: 40px;">
      <% page.sections.forEach(function (s) { %>
      <div>
        <h2 style="font-size: 24px; color: var(--ink); margin-bottom: 10px;"><%= s.h2 %></h2>
        <p style="font-size: 15px; color: var(--muted); line-height: 1.7; margin: 0;"><%= s.p %></p>
      </div>
      <% }) %>
    </div>
  </div>

  <!-- HOW IT WORKS -->
  <div style="max-width: 1180px; margin: 0 auto; padding: 64px 32px;">
    <h2 style="font-size: 26px; color: var(--ink); margin-bottom: 32px;">How it works</h2>
    <div class="grid-3">
      <% page.steps.forEach(function (s, i) { %>
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <span style="font-family: 'Newsreader', serif; font-size: 34px; color: #D8A87C;">0<%= i + 1 %></span>
        <h3 style="font-size: 17px;"><%= s.h %></h3>
        <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;"><%= s.p %></p>
      </div>
      <% }) %>
    </div>
  </div>

  <!-- PRICING NOTE + FAQ -->
  <div style="background: #FFFFFF; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
    <div style="max-width: 780px; margin: 0 auto; padding: 64px 32px; display: flex; flex-direction: column; gap: 36px;">
      <div class="card" style="padding: 24px; border-color: var(--accent);">
        <h2 style="font-size: 20px; color: var(--ink); margin-bottom: 8px;">Pricing</h2>
        <p style="font-size: 15px; color: var(--muted); line-height: 1.6; margin: 0;"><%= page.pricingNote %> <a href="/#pricing" style="color: var(--accent-deep); font-weight: 600;">See all plans</a></p>
      </div>
      <div>
        <h2 style="font-size: 24px; color: var(--ink); margin-bottom: 24px;">Common questions</h2>
        <div style="display: flex; flex-direction: column; gap: 24px;">
          <% page.faqs.forEach(function (f) { %>
          <div>
            <h3 style="font-size: 16px; color: var(--ink); margin-bottom: 6px;"><%= f.q %></h3>
            <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;"><%= f.a %></p>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div style="background: var(--ink); color: #FBF6EE;">
    <div style="max-width: 720px; margin: 0 auto; padding: 64px 32px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px;">
      <h2 style="font-size: 26px; color: #FBF6EE;">Start free. See it save you time.</h2>
      <p style="font-size: 15px; color: #C9BEA9; margin: 0;">Set up your first class and test in a few minutes — no card required.</p>
      <a href="<%= page.signup %>" class="btn btn-primary" style="margin-top: 8px;">Start your free 1-month trial</a>
    </div>
  </div>

  <!-- FOOTER -->
  <%- include('partials/public_footer', { current: slug }) %>

<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: page.title,
      description: page.description,
      url: canonicalUrl,
      isPartOf: { '@type': 'WebSite', name: 'ClassCoach', url: canonicalUrl.replace(/\/[^/]*$/, '/') }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ClassCoach', item: canonicalUrl.replace(/\/[^/]*$/, '/') },
        { '@type': 'ListItem', position: 2, name: page.nav, item: canonicalUrl }
      ]
    }
  ]
}).replace(/</g, '\\u003c') %>
</script>
</body>
</html>
